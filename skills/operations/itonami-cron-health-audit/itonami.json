{
  "schemaVersion": "itonami.entry.v1",
  "sourceRefs": [
    "fleet"
  ],
  "useWhen": "Cross-profile cron health diagnosis",
  "avoidWhen": "Automatic scheduling or credential changes",
  "inputs": {
    "profiles": "explicit scope",
    "collector": "owner-installed evidence argv",
    "window": "bounded observation period"
  },
  "outputs": {
    "report": "one finding plus evidence and gaps"
  },
  "effects": [
    "filesystem-read",
    "process",
    "optional-authorized-artifact-write"
  ],
  "authority": {
    "grants": false,
    "default": "blocked",
    "binding": "owner-reviewed target repository policy"
  },
  "validation": {
    "catalog": "schema-checked",
    "runtime": "not-tested",
    "live": false
  },
  "compatibilityNote": "Hermes storage format only; client installation and execution are not qualified. Wildcard versions do not establish runtime compatibility."
}
