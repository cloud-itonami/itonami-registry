{
  "schemaVersion": "1",
  "type": "mcp",
  "id": "murakumo-web",
  "name": "Murakumo Web",
  "version": "0.1.0",
  "description": "Connect to the owner-installed Murakumo web-plane MCP server; inspection is separate from authorized fleet operations.",
  "author": "cloud-itonami",
  "license": "MIT",
  "source": "https://github.com/kotoba-lang/murakumo/tree/896c30d0e0172d5ee8c95706b9081ab2ff621ecd",
  "compatibility": {
    "hermes": "*",
    "desktop": "*"
  },
  "transport": "stdio",
  "command": "node",
  "args": [
    "${MURAKUMO_REPO}/scripts/web_mcp.mjs"
  ],
  "env": {},
  "permissions": [
    "filesystem",
    "network",
    "process"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "MURAKUMO_REPO": {
        "type": "string",
        "description": "Absolute path to a caller-installed kotoba-lang/murakumo checkout at the source commit."
      }
    },
    "required": [
      "MURAKUMO_REPO"
    ],
    "additionalProperties": false
  }
}
