{
  "schemaVersion": "1",
  "type": "api",
  "id": "com-prolific-app",
  "name": "Prolific participant-recruitment client",
  "version": "1.0.0+f9d54998a13e",
  "description": "API client for prolific.com: recruit identity-verified human participants, build study payloads, resolve audience filters, and approve submissions. Not a clean-room reimplementation — Prolific sells access to real people, so there is nothing to clean-room.",
  "author": "kotoba-lang",
  "license": "Apache-2.0",
  "tags": [
    "client",
    "L3"
  ],
  "source": "https://github.com/kotoba-lang/com-prolific-app/tree/f9d54998a13e4bb82d8a7cf08ac585880a86e0d2",
  "compatibility": {
    "hermes": "none",
    "itonami": "*"
  },
  "api": {
    "kind": "client",
    "tier": "L3",
    "style": "rest-client",
    "entities": [
      "Study",
      "Filter",
      "Submission",
      "Participant"
    ],
    "routeCount": 7,
    "routes": [
      {
        "method": "GET",
        "path": "/users/me/",
        "op": "whoami"
      },
      {
        "method": "GET",
        "path": "/filters/",
        "op": "list filters + choice ids"
      },
      {
        "method": "POST",
        "path": "/studies/",
        "op": "create study"
      },
      {
        "method": "GET",
        "path": "/studies/{id}/",
        "op": "get study"
      },
      {
        "method": "POST",
        "path": "/studies/{id}/transition/",
        "op": "publish study"
      },
      {
        "method": "GET",
        "path": "/submissions/?study={id}",
        "op": "list submissions"
      },
      {
        "method": "POST",
        "path": "/submissions/{id}/transition/",
        "op": "approve submission"
      }
    ],
    "upstream": {
      "vendor": "Prolific Academic Ltd",
      "api": "https://api.prolific.com/api/v1",
      "docs": "https://docs.prolific.com/api-reference",
      "verifiedAt": "2026-07-28",
      "verifiedAgainst": "documentation-only — the live API has not been called"
    },
    "origin": {
      "status": "unverified",
      "sourceHost": "api.prolific.com"
    }
  },
