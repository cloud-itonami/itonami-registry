{
  "schemaVersion": "itonami.entry.v1",
  "sourceRefs": [
    "fleet"
  ],
  "useWhen": "Bot or cron fleet health audit",
  "avoidWhen": "Repairing or reassigning jobs without owner authorization",
  "inputs": {
    "profilesRoot": "caller-selected directory",
    "evidenceCommand": "owner-provided argv",
    "window": "bounded interval",
    "outputPath": "caller-authorized artifact path"
  },
  "outputs": {
    "finding": "measured change or unmeasured status",
    "evidence": "scheduler/log/output references"
  },
  "effects": [
    "filesystem-read",
    "optional-authorized-artifact-write"
  ],
  "authority": {
    "grants": false,
    "default": "blocked",
    "binding": "owner-reviewed target repository policy"
  },
  "validation": {
    "catalog": "schema-checked",
    "runtime": "not-tested",
    "live": false
  },
  "compatibilityNote": "Hermes storage format only; client installation and execution are not qualified. Wildcard versions do not establish runtime compatibility.",
  "dependsOn": [
    "skill/itonami-cron-health-audit"
  ],
  "roleKind": "yakuwari"
}
