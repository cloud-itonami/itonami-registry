{
  "schemaVersion": "itonami.entry.v1",
  "sourceRefs": [
    "isic",
    "isco"
  ],
  "useWhen": "Domain-specific physical simulation evidence and bounded improvement",
  "avoidWhen": "Live actuation or claims of hardware qualification",
  "inputs": {
    "targetRepo": "org/repo",
    "taxonomy": "system, edition, code",
    "premise": "documented physical task or explicit hypothesis",
    "specPath": "repository-relative simulation declaration",
    "testArgv": "owner-selected argv",
    "evidenceArgv": "owner-selected argv"
  },
  "outputs": {
    "finding": "one evidenced improvement proposal",
    "measurement": "units, assumptions, range and evidence"
  },
  "effects": [
    "process",
    "filesystem-read",
    "optional-owner-authorized-code-write"
  ],
  "authority": {
    "grants": false,
    "default": "blocked",
    "binding": "owner-reviewed target repository policy"
  },
  "validation": {
    "catalog": "schema-checked",
    "runtime": "not-tested",
    "live": false
  },
  "compatibilityNote": "Hermes storage format only; client installation and execution are not qualified. Wildcard versions do not establish runtime compatibility.",
  "roleKind": "yakuwari",
  "examples": [
    "examples/isic-7020.json",
    "examples/isco-2421.json"
  ]
}
