// Ncbi clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).
// L5 (Verified) 2026-06-09: remodeled from generic FHIR/bibliographic template
// to faithful NCBI Entrez E-utilities resources, reconciled against official docs
// NBK25501 (Overview) + NBK25499 (The E-utilities In-Depth: Parameters, Syntax).
// .kotoba DSL has no enum keyword; enumerated value sets are documented inline and
// stored in string fields. E-utility set: {einfo, esearch, epost, esummary, efetch,
// elink, egquery, espell, ecitmatch}.

namespace ncbi {

    // einfo response: an Entrez database. db with no value lists all DbNames;
    // db=<name> returns DbName/MenuName/Description/Count/LastUpdate + FieldList/LinkList.
    entity Database {
        id: string @unique
        dbName: string          // einfo DbName, e.g. pubmed, protein, nucleotide, nuccore, gene, genome, sra, snp
        menuName: string        // einfo MenuName, human-facing menu label
        description: string     // einfo Description
        count: long             // einfo Count (record count in the db)
        lastUpdate: datetime    // einfo LastUpdate
        createdAt: datetime
        updatedAt: datetime
    }

    // einfo FieldList element: a searchable/indexed field within a Database.
    entity DatabaseField {
        id: string @unique
        databaseId: string      // -> Database.id
        name: string            // einfo Field Name, e.g. ALL, TITL, AUTH, ORGN
        fullName: string        // einfo Field FullName
        description: string     // einfo Field Description
        termCount: long         // einfo Field TermCount
        isDate: bool            // einfo Field IsDate
        isNumerical: bool       // einfo Field IsNumerical
        isHidden: bool          // einfo Field IsHidden
        isTruncatable: bool     // einfo version=2.0 IsTruncatable
        isRangeable: bool       // einfo version=2.0 IsRangeable
        createdAt: datetime
        updatedAt: datetime
    }

    // esearch / esummary / efetch input + result envelope.
    // utility enum: {einfo, esearch, epost, esummary, efetch, elink, egquery, espell, ecitmatch}
    entity Query {
        id: string @unique
        utility: string         // E-utility name (enum above); typically esearch
        db: string              // target db (default pubmed)
        term: string            // esearch/egquery/espell term (Entrez text query)
        field: string           // esearch field limit, e.g. TITL, AUTH
        sort: string            // esearch sort: relevance|pub_date|Author|JournalName (db-specific)
        idType: string          // esearch/elink idtype: acc | (default GI)
        dateType: string        // datetype: mdat | pdat | edat
        relDate: int            // reldate: last N days
        minDate: string         // mindate: YYYY/MM/DD | YYYY/MM | YYYY
        maxDate: string         // maxdate: YYYY/MM/DD | YYYY/MM | YYYY
        useHistory: bool        // usehistory=y
        retMax: int             // esearch retmax (default 20, max 10000)
        retStart: int           // esearch retstart (default 0)
        retMode: string         // retmode: xml | json | text | asn.1 | default
        retType: string         // rettype: uilist | count (esearch); efetch values db-specific (see EFetchFormat)
        count: long             // esearch result Count (total matches)
        queryKey: int           // QueryKey on the History server
        webEnv: string          // WebEnv string on the History server
        queryTranslation: string // esearch QueryTranslation
        createdAt: datetime
        updatedAt: datetime
    }

    // A UID returned in an esearch IdList / posted via epost, scoped to a Query.
    entity SearchResultId {
        id: string @unique
        queryId: string         // -> Query.id
        uid: string             // UID (or accession.version when idtype=acc)
        position: int           // index within the IdList
        createdAt: datetime
        updatedAt: datetime
    }

    // esummary DocumentSummary / efetch record: a single Entrez record.
    entity EntrezRecord {
        id: string @unique
        uid: string             // esummary uid (Id)
        db: string              // owning Entrez database
        accession: string       // accession.version (sequence dbs)
        caption: string         // esummary Caption
        title: string           // esummary Title
        createdAt: datetime
        updatedAt: datetime
    }

    // elink result: a relationship from a UID in dbFrom to UIDs in dbTo.
    // cmd enum: {neighbor, neighbor_score, neighbor_history, acheck, ncheck,
    //            lcheck, llinks, llinkslib, prlinks}
    entity Link {
        id: string @unique
        dbFrom: string          // elink dbfrom (origin db, default pubmed)
        dbTo: string            // elink db (destination db, default pubmed)
        linkName: string        // elink LinkName, format dbfrom_db_subset
        cmd: string             // elink cmd (enum above; default neighbor)
        fromUid: string         // source UID in dbFrom
        toUid: string           // linked UID in dbTo
        score: long             // Link Score (cmd=neighbor_score)
        queryKey: int           // History QueryKey (cmd=neighbor_history)
        webEnv: string          // History WebEnv (cmd=neighbor_history)
        createdAt: datetime
        updatedAt: datetime
    }

    // egquery per-database result row (global query across all Entrez dbs).
    entity GlobalQueryResult {
        id: string @unique
        term: string            // egquery Term
        dbName: string          // egquery ResultItem DbName
        menuName: string        // egquery ResultItem MenuName
        count: long             // egquery ResultItem Count
        status: string          // egquery ResultItem Status, e.g. Ok
        createdAt: datetime
        updatedAt: datetime
    }

    // espell spelling-correction result.
    entity SpellResult {
        id: string @unique
        db: string              // espell Database
        query: string           // espell Query (original term)
        correctedQuery: string  // espell CorrectedQuery
        createdAt: datetime
        updatedAt: datetime
    }

    // ecitmatch citation lookup. db=pubmed, rettype=xml only.
    // bdata format: journal|year|volume|first_page|author|your_key|
    entity CitationMatch {
        id: string @unique
        db: string              // ecitmatch db (only pubmed)
        journal: string         // bdata journal_title
        year: string            // bdata year
        volume: string          // bdata volume
        firstPage: string       // bdata first_page
        author: string          // bdata author_name
        yourKey: string         // bdata your_key (echoed back)
        pmid: string            // matched PMID (or error token)
        createdAt: datetime
        updatedAt: datetime
    }

    // efetch valid rettype/retmode combination per database (NBK25499 Table 1).
    // retmode enum: {xml, text, asn.1, json, html, default}
    entity EFetchFormat {
        id: string @unique
        db: string              // pubmed, pmc, nuccore, protein, gene, ...
        retType: string         // e.g. docsum, uilist, abstract, medline, gb, gp, fasta, ft, gene_table, ipg, fasta_cds_na, fasta_cds_aa
        retMode: string         // retmode enum above
        description: string     // human label for the format combination
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
