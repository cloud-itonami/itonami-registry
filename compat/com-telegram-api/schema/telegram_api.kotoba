// Telegram_api clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace telegram_api {

    entity User {
        id: string @unique
        id: integer
        isBot: boolean
        firstName: string
        lastName: string
        username: string
        languageCode: string
        isPremium: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Chat {
        id: string @unique
        id: integer
        type: string
        title: string
        username: string
        firstName: string
        lastName: string
        isForum: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Message {
        id: string @unique
        messageId: integer
        date: integer
        text: string
        chatId: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity ChatMember {
        id: string @unique
        status: string
        isAnonymous: boolean
        customTitle: string
        createdAt: datetime
        updatedAt: datetime
    }

}
