// Dbt clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace dbt {

    entity Node {
        id: string @unique
        database: string
        schema: string
        name: string
        packageName: string
        uniqueId: string
        alias: string
        description: string
        compiled: boolean
        rawCode: string
        resourceType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Source {
        id: string @unique
        database: string
        schema: string
        name: string
        sourceName: string
        sourceDescription: string
        loader: string
        identifier: string
        uniqueId: string
        resourceType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity RunResult {
        id: string @unique
        threadId: string
        executionTime: float
        message: string
        failures: integer
        uniqueId: string
        compiled: boolean
        compiledCode: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}
