// Ddbj clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace ddbj {

    entity Patient {
        id: string @unique
        identifier: string
        givenName: string
        familyName: string
        birthDate: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Observation {
        id: string @unique
        patientId: string
        code: string
        value: string
        unit: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Condition {
        id: string @unique
        patientId: string
        code: string
        clinicalStatus: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity DiagnosticReport {
        id: string @unique
        patientId: string
        code: string
        status: string
        issuedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Sequence {
        id: string @unique
        patientId: string
        accession: string
        referenceGenome: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Specimen {
        id: string @unique
        patientId: string
        type: string
        collectedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
