namespace ibm_qiskit {

    entity Job {
        id: string @unique
        jobId: string
        backend: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity RuntimeJob {
        id: string @unique
        jobId: string
        programId: string
        creationDate: datetime
        image: string
        sessionId: string
        version: integer
        private: boolean
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Backend {
        id: string @unique
        name: string
        backendVersion: string
        numQubits: integer
        simulator: boolean
        local: boolean
        conditional: boolean
        openPulse: boolean
        memory: boolean
        dt: float
        dtm: float
        createdAt: datetime
        updatedAt: datetime
    }

}
