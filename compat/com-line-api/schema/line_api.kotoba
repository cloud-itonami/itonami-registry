// Line_api clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace line_api {

    entity Message {
        id: string @unique
        type: string
        text: string
        originalContentUrl: string
        previewImageUrl: string
        duration: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Source {
        id: string @unique
        type: string
        userId: string
        groupId: string
        roomId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Event {
        id: string @unique
        type: string
        mode: string
        replyToken: string
        timestamp: integer
        webhookEventId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Profile {
        id: string @unique
        displayName: string
        userId: string
        pictureUrl: string
        statusMessage: string
        language: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity SentMessage {
        id: string @unique
        id: string
        quoteToken: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity NarrowcastProgress {
        id: string @unique
        phase: string
        successCount: integer
        failureCount: integer
        targetCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
