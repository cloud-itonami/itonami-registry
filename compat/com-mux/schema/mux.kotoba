namespace mux {

    entity Asset {
        id: string @unique
        id: string
        status: string
        duration: float
        resolutionTier: string
        videoQuality: string
        aspectRatio: string
        test: boolean
        createdAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity PlaybackId {
        id: string @unique
        id: string
        policy: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Track {
        id: string @unique
        id: string
        type: string
        duration: float
        maxWidth: integer
        maxHeight: integer
        status: string
        primary: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Upload {
        id: string @unique
        id: string
        status: string
        timeout: integer
        test: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity LiveStream {
        id: string @unique
        id: string
        status: string
        latencyMode: string
        createdAt: datetime
        updatedAt: datetime
    }

}
