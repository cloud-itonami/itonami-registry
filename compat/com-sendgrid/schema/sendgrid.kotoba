// Sendgrid clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace sendgrid {

    entity Contact {
        id: string @unique
        email: string
        firstName: string
        lastName: string
        country: string
        externalId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Template {
        id: string @unique
        name: string
        generation: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity SingleSend {
        id: string @unique
        name: string
        status: string
        templateId: string
        senderId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Bounce {
        id: string @unique
        email: string
        reason: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity UnsubscribeGroup {
        id: string @unique
        name: string
        description: string
        isDefault: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Sender {
        id: string @unique
        nickname: string
        fromEmail: string
        fromName: string
        verified: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
