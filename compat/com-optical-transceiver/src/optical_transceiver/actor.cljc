         (assoc :transceiverId-obj (-pull port (get rec :optical_transceiver.Photodiode/transceiverId))))))))

(defn update-photodiode
  "Update a Photodiode; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :transceiverId) (conj [:db/add id :optical_transceiver.Photodiode/transceiverId (get data :transceiverId)]))
                   (cond-> (contains? data :material) (conj [:db/add id :optical_transceiver.Photodiode/material (get data :material)]))
                   (cond-> (contains? data :responsivityAW) (conj [:db/add id :optical_transceiver.Photodiode/responsivityAW (as-double (get data :responsivityAW))]))
                   (cond-> (contains? data :bandwidthGhz) (conj [:db/add id :optical_transceiver.Photodiode/bandwidthGhz (as-double (get data :bandwidthGhz))]))
                   (conj [:db/add id :optical_transceiver.Photodiode/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-photodiode
  "Delete a Photodiode."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

;; ── DomTelemetry ────────────────────────────────────────────────────────────────
(defn create-dom-telemetry
  "Create a DomTelemetry."
  [port data]
  (require-fields data ["txPowerDbm" "rxPowerDbm"])
  (let [id (new-id "oxc_dom")
        e {:db/id id
           :optical_transceiver.DomTelemetry/id id
           :optical_transceiver.DomTelemetry/transceiverId (get data :transceiverId)
           :optical_transceiver.DomTelemetry/txPowerDbm (as-double (get data :txPowerDbm))
           :optical_transceiver.DomTelemetry/rxPowerDbm (as-double (get data :rxPowerDbm))
           :optical_transceiver.DomTelemetry/tempC (as-double (get data :tempC))
           :optical_transceiver.DomTelemetry/createdAt (now)
           :optical_transceiver.DomTelemetry/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-dom-telemetries
  "List DomTelemetry with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-dom-telemetries port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :optical_transceiver.DomTelemetry/id))
         rows (apply-filters rows (:filter opts) [:optical_transceiver.DomTelemetry/transceiverId :optical_transceiver.DomTelemetry/txPowerDbm :optical_transceiver.DomTelemetry/rxPowerDbm :optical_transceiver.DomTelemetry/tempC])]
     (paginate rows opts))))

(defn get-dom-telemetry
  "Retrieve a DomTelemetry by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-dom-telemetry port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec
         (and want (contains? want :transceiverId) (get rec :optical_transceiver.DomTelemetry/transceiverId))
         (assoc :transceiverId-obj (-pull port (get rec :optical_transceiver.DomTelemetry/transceiverId))))))))

(defn update-dom-telemetry
  "Update a DomTelemetry; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :transceiverId) (conj [:db/add id :optical_transceiver.DomTelemetry/transceiverId (get data :transceiverId)]))
                   (cond-> (contains? data :txPowerDbm) (conj [:db/add id :optical_transceiver.DomTelemetry/txPowerDbm (as-double (get data :txPowerDbm))]))
                   (cond-> (contains? data :rxPowerDbm) (conj [:db/add id :optical_transceiver.DomTelemetry/rxPowerDbm (as-double (get data :rxPowerDbm))]))
                   (cond-> (contains? data :tempC) (conj [:db/add id :optical_transceiver.DomTelemetry/tempC (as-double (get data :tempC))]))
                   (conj [:db/add id :optical_transceiver.DomTelemetry/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-dom-telemetry
