(defn create-transceiver
  "Create a Transceiver."
  [port data]
  (require-fields data ["partNumber" "formFactor"])
  (let [id (new-id "oxc_tra")
        e {:db/id id
           :optical_transceiver.Transceiver/id id
           :optical_transceiver.Transceiver/partNumber (get data :partNumber)
           :optical_transceiver.Transceiver/formFactor (get data :formFactor)
           :optical_transceiver.Transceiver/dataRateGbps (as-double (get data :dataRateGbps))
           :optical_transceiver.Transceiver/reachM (as-double (get data :reachM))
           :optical_transceiver.Transceiver/createdAt (now)
           :optical_transceiver.Transceiver/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-transceivers
  "List Transceiver with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-transceivers port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :optical_transceiver.Transceiver/id))
         rows (apply-filters rows (:filter opts) [:optical_transceiver.Transceiver/partNumber :optical_transceiver.Transceiver/formFactor :optical_transceiver.Transceiver/dataRateGbps :optical_transceiver.Transceiver/reachM])]
     (paginate rows opts))))

(defn get-transceiver
  "Retrieve a Transceiver by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-transceiver port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-transceiver
  "Update a Transceiver; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :partNumber) (conj [:db/add id :optical_transceiver.Transceiver/partNumber (get data :partNumber)]))
                   (cond-> (contains? data :formFactor) (conj [:db/add id :optical_transceiver.Transceiver/formFactor (get data :formFactor)]))
                   (cond-> (contains? data :dataRateGbps) (conj [:db/add id :optical_transceiver.Transceiver/dataRateGbps (as-double (get data :dataRateGbps))]))
                   (cond-> (contains? data :reachM) (conj [:db/add id :optical_transceiver.Transceiver/reachM (as-double (get data :reachM))]))
                   (conj [:db/add id :optical_transceiver.Transceiver/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-transceiver
  "Delete a Transceiver."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

