// Hopin clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace hopin {

    entity Event {
        id: string @unique
        name: string
        startsAt: datetime
        venue: string
        capacity: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Ticket {
        id: string @unique
        eventId: string
        type: string
        price: float
        sold: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Attendee {
        id: string @unique
        eventId: string
        email: string
        checkedIn: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Donor {
        id: string @unique
        email: string
        name: string
        lifetimeValue: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Donation {
        id: string @unique
        donorId: string
        amount: float
        currency: string
        recurring: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Membership {
        id: string @unique
        memberId: string
        tier: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
