  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

;; ── GuardrailCheck ────────────────────────────────────────────────────────────────
(defn create-guardrail-check
  "Create a GuardrailCheck."
  [port data]
  (require-fields data ["policy" "verdict"])
  (let [id (new-id "cosmos_gua")
        e {:db/id id
           :nvidia_cosmos.GuardrailCheck/id id
           :nvidia_cosmos.GuardrailCheck/simRunId (get data :simRunId)
           :nvidia_cosmos.GuardrailCheck/policy (get data :policy)
           :nvidia_cosmos.GuardrailCheck/verdict (get data :verdict)
           :nvidia_cosmos.GuardrailCheck/score (as-double (get data :score))
           :nvidia_cosmos.GuardrailCheck/createdAt (now)
           :nvidia_cosmos.GuardrailCheck/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-guardrail-checks
  "List GuardrailCheck with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-guardrail-checks port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :nvidia_cosmos.GuardrailCheck/id))
         rows (apply-filters rows (:filter opts) [:nvidia_cosmos.GuardrailCheck/simRunId :nvidia_cosmos.GuardrailCheck/policy :nvidia_cosmos.GuardrailCheck/verdict :nvidia_cosmos.GuardrailCheck/score])]
     (paginate rows opts))))

(defn get-guardrail-check
  "Retrieve a GuardrailCheck by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-guardrail-check port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec
         (and want (contains? want :simRunId) (get rec :nvidia_cosmos.GuardrailCheck/simRunId))
         (assoc :simRunId-obj (-pull port (get rec :nvidia_cosmos.GuardrailCheck/simRunId))))))))

(defn update-guardrail-check
  "Update a GuardrailCheck; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :simRunId) (conj [:db/add id :nvidia_cosmos.GuardrailCheck/simRunId (get data :simRunId)]))
                   (cond-> (contains? data :policy) (conj [:db/add id :nvidia_cosmos.GuardrailCheck/policy (get data :policy)]))
                   (cond-> (contains? data :verdict) (conj [:db/add id :nvidia_cosmos.GuardrailCheck/verdict (get data :verdict)]))
                   (cond-> (contains? data :score) (conj [:db/add id :nvidia_cosmos.GuardrailCheck/score (as-double (get data :score))]))
                   (conj [:db/add id :nvidia_cosmos.GuardrailCheck/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-guardrail-check
  "Delete a GuardrailCheck."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

