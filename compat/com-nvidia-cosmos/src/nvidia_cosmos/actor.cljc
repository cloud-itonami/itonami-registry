(defn create-world-model
  "Create a WorldModel."
  [port data]
  (require-fields data ["name" "modelType"])
  (let [id (new-id "cosmos_wor")
        e {:db/id id
           :nvidia_cosmos.WorldModel/id id
           :nvidia_cosmos.WorldModel/name (get data :name)
           :nvidia_cosmos.WorldModel/modelType (get data :modelType)
           :nvidia_cosmos.WorldModel/parameters (as-long (get data :parameters))
           :nvidia_cosmos.WorldModel/checkpoint (get data :checkpoint)
           :nvidia_cosmos.WorldModel/license (get data :license)
           :nvidia_cosmos.WorldModel/createdAt (now)
           :nvidia_cosmos.WorldModel/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-world-models
  "List WorldModel with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-world-models port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :nvidia_cosmos.WorldModel/id))
         rows (apply-filters rows (:filter opts) [:nvidia_cosmos.WorldModel/name :nvidia_cosmos.WorldModel/modelType :nvidia_cosmos.WorldModel/parameters :nvidia_cosmos.WorldModel/checkpoint :nvidia_cosmos.WorldModel/license])]
     (paginate rows opts))))

(defn get-world-model
  "Retrieve a WorldModel by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-world-model port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-world-model
  "Update a WorldModel; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :name) (conj [:db/add id :nvidia_cosmos.WorldModel/name (get data :name)]))
                   (cond-> (contains? data :modelType) (conj [:db/add id :nvidia_cosmos.WorldModel/modelType (get data :modelType)]))
                   (cond-> (contains? data :parameters) (conj [:db/add id :nvidia_cosmos.WorldModel/parameters (as-long (get data :parameters))]))
                   (cond-> (contains? data :checkpoint) (conj [:db/add id :nvidia_cosmos.WorldModel/checkpoint (get data :checkpoint)]))
                   (cond-> (contains? data :license) (conj [:db/add id :nvidia_cosmos.WorldModel/license (get data :license)]))
                   (conj [:db/add id :nvidia_cosmos.WorldModel/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-world-model
  "Delete a WorldModel."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

