// nvidia_cosmos clean-room schema -> Datomic EAVT mapping
// World Foundation Models / Physical AI simulation.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace nvidia_cosmos {

    entity WorldModel {
        id: string @unique
        name: string
        modelType: string
        parameters: integer
        checkpoint: string
        license: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Tokenizer {
        id: string @unique
        name: string
        kind: string
        compressionRatio: float
        modality: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity SimRun {
        id: string @unique
        worldModelId: string
        prompt: string
        frames: integer
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Embodiment {
        id: string @unique
        name: string
        dof: integer
        robotType: string
        urdf: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Prompt {
        id: string @unique
        text: string
        modality: string
        conditioning: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity GuardrailCheck {
        id: string @unique
        simRunId: string
        policy: string
        verdict: string
        score: float
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
