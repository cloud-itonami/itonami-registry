(ns adyen.paginate
  (:export [as-int has-more? main test-kernel]))

;; Bounded pure-int slice of adyen.main/paginate: the pagination *decision*
;; kernel only. The .cljc `paginate` stays authoritative for cursor walking
;; over rows (string ids, `starting_after`); what migrates here is the pure
;; integer decision the handler makes after the rows are cut: coerce the
;; requested limit and decide whether another page exists.
;; No strings, no maps, no folds -- the same subset page_limit.kotoba lives in.

;; Positive-int coercion of an untrusted page-size input. The .cljc `as-int`
;; accepts strings and maps to 0 on failure; that parse half stays on the
;; oracle (strings are outside the admitted subset). Once a caller has an
;; integer, this is its value shape: non-positive collapses to 0.
(defn as-int [v]
  (if (> v 0) v 0))

;; The `has_more` decision of handle-list: the row supply outgrew the page
;; when the remaining count strictly exceeds the applied limit.
(defn has-more? [remaining limit]
  (if (> remaining limit) 1 0))

;; Qualification probe: returns a bool via (and ...), 1 iff every parity
;; case across coerce -> has-more matches the retained cljc oracle.
(defn test-kernel []
  (and (= (as-int -5) 0)
       (= (as-int 7) 7)
       (= (has-more? 101 100) 1)
       (= (has-more? 20 20) 0)))

(defn main []
  (has-more? 101 (as-int 100)))
