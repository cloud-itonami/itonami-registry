namespace benchling {

    entity CustomEntity {
        id: string @unique
        apiURL: string
        entityRegistryId: string
        folderId: string
        modifiedAt: datetime
        name: string
        registryId: string
        url: string
        webURL: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity DnaSequence {
        id: string @unique
        apiURL: string
        bases: string
        entityRegistryId: string
        folderId: string
        isCircular: boolean
        length: integer
        modifiedAt: datetime
        name: string
        registryId: string
        url: string
        webURL: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Entry {
        id: string @unique
        apiURL: string
        displayId: string
        entryTemplateId: string
        folderId: string
        modifiedAt: string
        name: string
        webURL: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Folder {
        id: string @unique
        name: string
        parentFolderId: string
        projectId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Project {
        id: string @unique
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Request {
        id: string @unique
        apiURL: string
        displayId: string
        projectId: string
        requestStatus: string
        scheduledOn: datetime
        webURL: string
        createdAt: datetime
        updatedAt: datetime
    }

}
