// Vercel clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace vercel {

    entity Deployment {
        id: string @unique
        name: string
        projectId: string
        url: string
        readyState: string
        target: string
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Project {
        id: string @unique
        name: string
        accountId: string
        nodeVersion: string
        framework: string
        buildCommand: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Domain {
        id: string @unique
        name: string
        verified: boolean
        serviceType: string
        expiresAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Alias {
        id: string @unique
        alias: string
        deploymentId: string
        projectId: string
        redirectStatusCode: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Team {
        id: string @unique
        name: string
        slug: string
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

}
