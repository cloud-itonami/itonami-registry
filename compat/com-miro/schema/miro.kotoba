// Miro clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace miro {

    entity Board {
        id: string @unique
        name: string
        description: string
        type: string
        viewLink: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Item {
        id: string @unique
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Tag {
        id: string @unique
        title: string
        fillColor: string
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity BoardMember {
        id: string @unique
        name: string
        role: string
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Organization {
        id: string @unique
        name: string
        plan: string
        fullLicensesPurchased: integer
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Connector {
        id: string @unique
        shape: string
        isSupported: boolean
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

}
