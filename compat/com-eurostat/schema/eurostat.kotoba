// Eurostat clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace eurostat {

    entity Filing {
        id: string @unique
        filerId: string
        scheme: string
        period: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Citizen {
        id: string @unique
        nationalId: string
        jurisdiction: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Service {
        id: string @unique
        name: string
        department: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Application {
        id: string @unique
        citizenId: string
        serviceId: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Dataset {
        id: string @unique
        name: string
        publisher: string
        updatedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Identity {
        id: string @unique
        citizenId: string
        assuranceLevel: string
        verified: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
