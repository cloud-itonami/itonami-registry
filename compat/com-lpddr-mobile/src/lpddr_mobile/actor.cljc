                   (cond-> (contains? data :deviceId) (conj [:db/add id :lpddr_mobile.SpeedBin/deviceId (get data :deviceId)]))
                   (cond-> (contains? data :grade) (conj [:db/add id :lpddr_mobile.SpeedBin/grade (get data :grade)]))
                   (cond-> (contains? data :voltageV) (conj [:db/add id :lpddr_mobile.SpeedBin/voltageV (as-double (get data :voltageV))]))
                   (cond-> (contains? data :dataRateMtps) (conj [:db/add id :lpddr_mobile.SpeedBin/dataRateMtps (as-long (get data :dataRateMtps))]))
                   (conj [:db/add id :lpddr_mobile.SpeedBin/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-speed-bin
  "Delete a SpeedBin."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

;; ── JedecSpec ────────────────────────────────────────────────────────────────
(defn create-jedec-spec
  "Create a JedecSpec."
  [port data]
  (require-fields data ["standard" "revision"])
  (let [id (new-id "lpd_jed")
        e {:db/id id
           :lpddr_mobile.JedecSpec/id id
           :lpddr_mobile.JedecSpec/deviceId (get data :deviceId)
           :lpddr_mobile.JedecSpec/standard (get data :standard)
           :lpddr_mobile.JedecSpec/revision (get data :revision)
           :lpddr_mobile.JedecSpec/compliant (as-bool (get data :compliant))
           :lpddr_mobile.JedecSpec/createdAt (now)
           :lpddr_mobile.JedecSpec/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-jedec-specs
  "List JedecSpec with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-jedec-specs port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :lpddr_mobile.JedecSpec/id))
         rows (apply-filters rows (:filter opts) [:lpddr_mobile.JedecSpec/deviceId :lpddr_mobile.JedecSpec/standard :lpddr_mobile.JedecSpec/revision :lpddr_mobile.JedecSpec/compliant])]
     (paginate rows opts))))

(defn get-jedec-spec
  "Retrieve a JedecSpec by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-jedec-spec port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-jedec-spec
  "Update a JedecSpec; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :deviceId) (conj [:db/add id :lpddr_mobile.JedecSpec/deviceId (get data :deviceId)]))
                   (cond-> (contains? data :standard) (conj [:db/add id :lpddr_mobile.JedecSpec/standard (get data :standard)]))
                   (cond-> (contains? data :revision) (conj [:db/add id :lpddr_mobile.JedecSpec/revision (get data :revision)]))
                   (cond-> (contains? data :compliant) (conj [:db/add id :lpddr_mobile.JedecSpec/compliant (as-bool (get data :compliant))]))
                   (conj [:db/add id :lpddr_mobile.JedecSpec/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-jedec-spec
  "Delete a JedecSpec."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

