(defn create-lpddr-device
  "Create a LpddrDevice."
  [port data]
  (require-fields data ["partNumber" "generation"])
  (let [id (new-id "lpd_lpd")
        e {:db/id id
           :lpddr_mobile.LpddrDevice/id id
           :lpddr_mobile.LpddrDevice/partNumber (get data :partNumber)
           :lpddr_mobile.LpddrDevice/generation (get data :generation)
           :lpddr_mobile.LpddrDevice/densityGb (as-long (get data :densityGb))
           :lpddr_mobile.LpddrDevice/dataRateMtps (as-long (get data :dataRateMtps))
           :lpddr_mobile.LpddrDevice/createdAt (now)
           :lpddr_mobile.LpddrDevice/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-lpddr-devices
  "List LpddrDevice with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-lpddr-devices port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :lpddr_mobile.LpddrDevice/id))
         rows (apply-filters rows (:filter opts) [:lpddr_mobile.LpddrDevice/partNumber :lpddr_mobile.LpddrDevice/generation :lpddr_mobile.LpddrDevice/densityGb :lpddr_mobile.LpddrDevice/dataRateMtps])]
     (paginate rows opts))))

(defn get-lpddr-device
  "Retrieve a LpddrDevice by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-lpddr-device port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-lpddr-device
  "Update a LpddrDevice; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :partNumber) (conj [:db/add id :lpddr_mobile.LpddrDevice/partNumber (get data :partNumber)]))
                   (cond-> (contains? data :generation) (conj [:db/add id :lpddr_mobile.LpddrDevice/generation (get data :generation)]))
                   (cond-> (contains? data :densityGb) (conj [:db/add id :lpddr_mobile.LpddrDevice/densityGb (as-long (get data :densityGb))]))
                   (cond-> (contains? data :dataRateMtps) (conj [:db/add id :lpddr_mobile.LpddrDevice/dataRateMtps (as-long (get data :dataRateMtps))]))
                   (conj [:db/add id :lpddr_mobile.LpddrDevice/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-lpddr-device
  "Delete a LpddrDevice."
