{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.11.1"}
        ;; W6 product-shell oracle authority: execute precompiled pure KIR.
        ;; Compiler stays :test-only.
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.osaho"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is TEST-ONLY for the W6 pure oracle
         ;; parity gate (kotoba/compat_core.kotoba). Override abi to the pin
         ;; compiler expects so component/wit loads cleanly in the test JVM.
         :override-deps
         {io.github.kotoba-lang/abi
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.abi"}}
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "98b56bdb6886236281b634cc3409088ed2fe72a4"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :oracle-gen {:extra-paths ["test"]
               :override-deps
               {io.github.kotoba-lang/abi
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.abi"}}
               :extra-deps {io.github.kotoba-lang/amu
                            {:git/url "https://github.com/kotoba-lang/amu.git"
                             :git/sha "98b56bdb6886236281b634cc3409088ed2fe72a4"}}
               :main-opts ["-m" "cloudflare.kotoba-oracle-gen"]}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
