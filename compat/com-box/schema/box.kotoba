// Box clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace box {

    entity File {
        id: string @unique
        name: string
        description: string
        size: integer
        sha1: string
        itemStatus: string
        commentCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Folder {
        id: string @unique
        name: string
        description: string
        size: integer
        itemStatus: string
        syncState: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        name: string
        login: string
        status: string
        role: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Collaboration {
        id: string @unique
        role: string
        status: string
        isAccessOnly: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity SharedLink {
        id: string @unique
        access: string
        vanityName: string
        canDownload: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Comment {
        id: string @unique
        message: string
        isReplyComment: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
