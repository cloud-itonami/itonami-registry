// Crossref clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).
// L5 (Verified) 2026-06-09: reconciled against official Crossref REST API docs
// (api_format.md, api.crossref.org live routes /works /funders /journals /members
// /prefixes /types). Resources + fields below are doc/route-confirmed; provenance
// recorded in the L5 verification entry.

namespace crossref {

    // Work: the core Crossref scholarly metadata record, keyed by DOI.
    // Plural/array fields (title, container-title, ISSN, ISBN, subject, author,
    // reference) and date-parts structures are modeled as json to preserve the
    // native Crossref shape.
    entity Work {
        id: string @unique
        doi: string
        title: json
        subtitle: json
        type: string
        source: string
        publisher: string
        containerTitle: json
        shortContainerTitle: json
        issn: json
        issnType: json
        isbn: json
        volume: string
        issue: string
        page: string
        articleNumber: string
        abstract: string
        language: string
        author: json
        reference: json
        subject: json
        funder: json
        license: json
        link: json
        issued: json
        published: json
        publishedPrint: json
        publishedOnline: json
        created: datetime
        deposited: datetime
        indexed: datetime
        isReferencedByCount: int
        referencesCount: int
        score: json
        prefix: string
        memberId: string
        createdAt: datetime
        updatedAt: datetime
    }

    // Author/contributor of a Work (author, editor, translator, chair).
    // affiliation is a json array of organization objects per Crossref shape.
    entity Author {
        id: string @unique
        workId: string
        given: string
        family: string
        name: string
        suffix: string
        orcid: string
        authenticatedOrcid: bool
        sequence: string
        affiliation: json
        createdAt: datetime
        updatedAt: datetime
    }

    // A reference (cited work) inside a Work's reference[] list.
    // Renamed from the generic Citation template to the real Crossref field name.
    entity Reference {
        id: string @unique
        workId: string
        key: string
        doi: string
        doiAssertedBy: string
        author: string
        year: string
        volume: string
        issue: string
        firstPage: string
        journalTitle: string
        articleTitle: string
        volumeTitle: string
        seriesTitle: string
        issn: string
        issnType: string
        isbn: string
        isbnType: string
        unstructured: string
        createdAt: datetime
        updatedAt: datetime
    }

    // Funder registry entry (/funders route). id is the Funder DOI.
    entity Funder {
        id: string @unique
        name: string
        altNames: json
        location: string
        uri: string
        replaces: json
        replacedBy: json
        tokens: json
        createdAt: datetime
        updatedAt: datetime
    }

    // Journal registry entry (/journals route), keyed by ISSN.
    entity Journal {
        id: string @unique
        title: string
        publisher: string
        issn: json
        issnType: json
        subjects: json
        coverage: json
        coverageType: json
        counts: json
        breakdowns: json
        flags: json
        lastStatusCheckTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    // Member (depositing organization) registry entry (/members route).
    entity Member {
        id: string @unique
        primaryName: string
        names: json
        location: string
        prefix: json
        tokens: json
        counts: json
        countsType: json
        breakdowns: json
        coverage: json
        coverageType: json
        flags: json
        lastStatusCheckTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    // DOI prefix registry entry (/prefixes route).
    entity Prefix {
        id: string @unique
        prefix: string
        name: string
        memberId: string
        createdAt: datetime
        updatedAt: datetime
    }

    // Crossref work-type controlled vocabulary (/types route, 30 members).
    enum WorkType {
        bookSection
        monograph
        reportComponent
        report
        peerReview
        bookTrack
        journalArticle
        bookPart
        other
        book
        journalVolume
        bookSet
        referenceEntry
        proceedingsArticle
        journal
        component
        bookChapter
        proceedingsSeries
        reportSeries
        proceedings
        database
        standard
        referenceBook
        postedContent
        journalIssue
        dissertation
        grant
        dataset
        bookSeries
        editedBook
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
