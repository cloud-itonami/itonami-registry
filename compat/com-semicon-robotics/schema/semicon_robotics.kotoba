// semicon_robotics clean-room schema -> Datomic EAVT mapping
// Fab-automation robotics — wafer handling design + implementation.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace semicon_robotics {

    entity WaferRobot {
        id: string @unique
        name: string
        vendor: string
        axes: integer
        payloadKg: float
        cleanClass: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity EfemModule {
        id: string @unique
        robotId: string
        ports: integer
        ffuFlowM3h: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity TransferJob {
        id: string @unique
        robotId: string
        source: string
        destination: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity LoadPort {
        id: string @unique
        moduleId: string
        standard: string
        slots: integer
        occupied: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity MotionProgram {
        id: string @unique
        robotId: string
        name: string
        waypoints: integer
        cycleTimeS: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Interlock {
        id: string @unique
        robotId: string
        kind: string
        triggered: boolean
        severity: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
