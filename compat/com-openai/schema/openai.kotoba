// Openai clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace openai {

    entity Model {
        id: string @unique
        id: string
        object: string
        created: integer
        ownedBy: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity FineTuningJob {
        id: string @unique
        id: string
        model: string
        status: string
        fineTunedModel: string
        createdAt: integer
        finishedAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Batch {
        id: string @unique
        id: string
        object: string
        endpoint: string
        model: string
        status: string
        inputFileId: string
        createdAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity File {
        id: string @unique
        id: string
        bytes: integer
        filename: string
        object: string
        purpose: string
        status: string
        createdAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Embedding {
        id: string @unique
        index: integer
        object: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ChatCompletion {
        id: string @unique
        id: string
        model: string
        object: string
        created: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
