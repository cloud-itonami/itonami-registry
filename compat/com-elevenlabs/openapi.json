  "components": {
    "schemas": {
      "Voice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "voiceId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "generated",
              "cloned",
              "premade",
              "professional",
              "famous",
              "high_quality"
            ]
