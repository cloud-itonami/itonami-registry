namespace elevenlabs {

    entity Voice {
        id: string @unique
        voiceId: string
        name: string
        category: string
        description: string
        previewUrl: string
        createdAtUnix: integer
        isOwner: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Sample {
        id: string @unique
        sampleId: string
        fileName: string
        mimeType: string
        sizeBytes: integer
        durationSecs: float
        hash: string
        removeBackgroundNoise: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity HistoryItem {
        id: string @unique
        historyItemId: string
        voiceId: string
        modelId: string
        text: string
        dateUnix: integer
        state: string
        characterCountChangeTo: integer
        contentType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Model {
        id: string @unique
        modelId: string
        name: string
        canBeFinetune: boolean
        canDoTextToSpeech: boolean
        canUseStyle: boolean
        tokenCostFactor: float
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Subscription {
        id: string @unique
        tier: string
        characterCount: integer
        characterLimit: integer
        voiceSlotsUsed: integer
        voiceLimit: integer
        status: string
        canExtendCharacterLimit: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Project {
        id: string @unique
        projectId: string
        name: string
        title: string
        author: string
        createDateUnix: integer
        state: string
        accessLevel: string
        canBeDownloaded: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
