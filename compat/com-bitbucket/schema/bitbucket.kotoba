// Bitbucket clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace bitbucket {

    entity PullRequest {
        id: string @unique
        id: integer
        title: string
        state: string
        draft: boolean
        createdOn: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Repository {
        id: string @unique
        name: string
        fullName: string
        scm: string
        isPrivate: boolean
        uuid: string
        createdOn: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Workspace {
        id: string @unique
        name: string
        slug: string
        uuid: string
        isPrivate: boolean
        createdOn: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Project {
        id: string @unique
        name: string
        key: string
        uuid: string
        isPrivate: boolean
        createdOn: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Issue {
        id: string @unique
        id: integer
        title: string
        state: string
        priority: string
        kind: string
        createdOn: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Commit {
        id: string @unique
        hash: string
        message: string
        date: datetime
        summary: string
        author: string
        createdAt: datetime
        updatedAt: datetime
    }

}
