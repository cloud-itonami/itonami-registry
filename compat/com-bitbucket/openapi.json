  "components": {
    "schemas": {
      "PullRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "OPEN",
              "MERGED",
              "DECLINED",
              "SUPERSEDED"
            ]
          },
          "draft": {
