// Anthropic clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace anthropic {

    entity Model {
        id: string @unique
        name: string
        family: string
        contextWindow: integer
        maxOutputTokens: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Message {
        id: string @unique
        modelId: string
        role: string
        content: string
        inputTokens: integer
        outputTokens: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Conversation {
        id: string @unique
        modelId: string
        systemPrompt: string
        turnCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Tool {
        id: string @unique
        name: string
        description: string
        inputSchemaRef: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ToolUse {
        id: string @unique
        messageId: string
        toolName: string
        inputRef: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Batch {
        id: string @unique
        modelId: string
        requestCount: integer
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity File {
        id: string @unique
        filename: string
        mimeType: string
        bytes: integer
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
