// riscv_cpu clean-room schema -> Datomic EAVT mapping
// CPU core microarchitecture design (RISC-V ISA).
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace riscv_cpu {

    entity CpuCore {
        id: string @unique
        name: string
        isa: string
        microarch: string
        frequencyGhz: float
        issueWidth: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Pipeline {
        id: string @unique
        coreId: string
        stages: integer
        type: string
        branchPredictor: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity RegisterFile {
        id: string @unique
        coreId: string
        kind: string
        count: integer
        widthBits: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity CacheLevel {
        id: string @unique
        coreId: string
        level: string
        sizeKb: integer
        associativity: integer
        latencyCycles: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity IsaExtension {
        id: string @unique
        coreId: string
        name: string
        version: string
        ratified: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Microbench {
        id: string @unique
        coreId: string
        name: string
        ipc: float
        scoreType: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
