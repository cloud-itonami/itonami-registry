  "Create a CpuCore."
  [port data]
  (require-fields data ["name" "isa"])
  (let [id (new-id "cpu_cpu")
        e {:db/id id
           :riscv_cpu.CpuCore/id id
           :riscv_cpu.CpuCore/name (get data :name)
           :riscv_cpu.CpuCore/isa (get data :isa)
           :riscv_cpu.CpuCore/microarch (get data :microarch)
           :riscv_cpu.CpuCore/frequencyGhz (as-double (get data :frequencyGhz))
           :riscv_cpu.CpuCore/issueWidth (as-long (get data :issueWidth))
           :riscv_cpu.CpuCore/createdAt (now)
           :riscv_cpu.CpuCore/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-cpu-cores
  "List CpuCore with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-cpu-cores port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :riscv_cpu.CpuCore/id))
         rows (apply-filters rows (:filter opts) [:riscv_cpu.CpuCore/name :riscv_cpu.CpuCore/isa :riscv_cpu.CpuCore/microarch :riscv_cpu.CpuCore/frequencyGhz :riscv_cpu.CpuCore/issueWidth])]
     (paginate rows opts))))

(defn get-cpu-core
  "Retrieve a CpuCore by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-cpu-core port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-cpu-core
  "Update a CpuCore; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :name) (conj [:db/add id :riscv_cpu.CpuCore/name (get data :name)]))
                   (cond-> (contains? data :isa) (conj [:db/add id :riscv_cpu.CpuCore/isa (get data :isa)]))
                   (cond-> (contains? data :microarch) (conj [:db/add id :riscv_cpu.CpuCore/microarch (get data :microarch)]))
                   (cond-> (contains? data :frequencyGhz) (conj [:db/add id :riscv_cpu.CpuCore/frequencyGhz (as-double (get data :frequencyGhz))]))
                   (cond-> (contains? data :issueWidth) (conj [:db/add id :riscv_cpu.CpuCore/issueWidth (as-long (get data :issueWidth))]))
