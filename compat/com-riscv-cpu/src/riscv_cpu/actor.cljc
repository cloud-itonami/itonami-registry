    (let [sets (-> []
                   (cond-> (contains? data :coreId) (conj [:db/add id :riscv_cpu.IsaExtension/coreId (get data :coreId)]))
                   (cond-> (contains? data :name) (conj [:db/add id :riscv_cpu.IsaExtension/name (get data :name)]))
                   (cond-> (contains? data :version) (conj [:db/add id :riscv_cpu.IsaExtension/version (get data :version)]))
                   (cond-> (contains? data :ratified) (conj [:db/add id :riscv_cpu.IsaExtension/ratified (as-bool (get data :ratified))]))
                   (conj [:db/add id :riscv_cpu.IsaExtension/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-isa-extension
