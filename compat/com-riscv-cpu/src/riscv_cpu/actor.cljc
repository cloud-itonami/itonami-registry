;; ── Microbench ────────────────────────────────────────────────────────────────
(defn create-microbench
  "Create a Microbench."
  [port data]
  (require-fields data ["name" "ipc"])
  (let [id (new-id "cpu_mic")
        e {:db/id id
           :riscv_cpu.Microbench/id id
           :riscv_cpu.Microbench/coreId (get data :coreId)
           :riscv_cpu.Microbench/name (get data :name)
           :riscv_cpu.Microbench/ipc (as-double (get data :ipc))
           :riscv_cpu.Microbench/scoreType (get data :scoreType)
           :riscv_cpu.Microbench/createdAt (now)
           :riscv_cpu.Microbench/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-microbenches
  "List Microbench with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-microbenches port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :riscv_cpu.Microbench/id))
         rows (apply-filters rows (:filter opts) [:riscv_cpu.Microbench/coreId :riscv_cpu.Microbench/name :riscv_cpu.Microbench/ipc :riscv_cpu.Microbench/scoreType])]
     (paginate rows opts))))

(defn get-microbench
  "Retrieve a Microbench by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-microbench port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-microbench
  "Update a Microbench; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :coreId) (conj [:db/add id :riscv_cpu.Microbench/coreId (get data :coreId)]))
                   (cond-> (contains? data :name) (conj [:db/add id :riscv_cpu.Microbench/name (get data :name)]))
                   (cond-> (contains? data :ipc) (conj [:db/add id :riscv_cpu.Microbench/ipc (as-double (get data :ipc))]))
                   (cond-> (contains? data :scoreType) (conj [:db/add id :riscv_cpu.Microbench/scoreType (get data :scoreType)]))
                   (conj [:db/add id :riscv_cpu.Microbench/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-microbench
  "Delete a Microbench."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

