// Discord clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace discord {

    entity Channel {
        id: string @unique
        id: string
        type: integer
        name: string
        guildId: string
        position: integer
        topic: string
        nsfw: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Guild {
        id: string @unique
        id: string
        name: string
        ownerId: string
        description: string
        premiumTier: integer
        verificationLevel: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Message {
        id: string @unique
        id: string
        channelId: string
        content: string
        type: integer
        pinned: boolean
        tts: boolean
        timestamp: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        id: string
        username: string
        discriminator: string
        globalName: string
        bot: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Role {
        id: string @unique
        id: string
        name: string
        color: integer
        position: integer
        hoist: boolean
        managed: boolean
        mentionable: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
