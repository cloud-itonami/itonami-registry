  "components": {
    "schemas": {
      "LoanAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "encodedKey": {
            "type": "string"
          },
          "accountState": {
            "type": "string",
            "enum": [
              "PARTIAL_APPLICATION",
              "PENDING_APPROVAL",
              "APPROVED",
              "ACTIVE",
              "ACTIVE_IN_ARREARS",
              "CLOSED",
              "CLOSED_WRITTEN_OFF",
              "CLOSED_REJECTED"
            ]
          },
          "accountSubState": {
            "type": "string",
            "enum": [
              "PARTIALLY_DISBURSED",
              "LOCKED",
              "LOCKED_CAPPING",
              "REFINANCED",
              "RESCHEDULED",
              "WITHDRAWN",
              "REPAID",
              "REJECTED",
              "WRITTEN_OFF",
              "TERMINATED"
            ]
          },
          "accountHolderType": {
            "type": "string",
            "enum": [
              "CLIENT",
              "GROUP"
            ]
          },
          "accountHolderKey": {
            "type": "string"
          },
          "loanAmount": {
            "type": "number"
          },
          "loanName": {
            "type": "string"
          },
          "daysInArrears": {
            "type": "integer"
          },
          "creationDate": {
            "type": "string",
            "format": "date-time"
          },
          "approvedDate": {
            "type": "string",
            "format": "date-time"
          },
          "closedDate": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoanAccountCreate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "encodedKey": {
            "type": "string"
          },
          "accountState": {
            "type": "string",
            "enum": [
              "PARTIAL_APPLICATION",
              "PENDING_APPROVAL",
              "APPROVED",
              "ACTIVE",
              "ACTIVE_IN_ARREARS",
              "CLOSED",
              "CLOSED_WRITTEN_OFF",
              "CLOSED_REJECTED"
            ]
          },
          "accountSubState": {
            "type": "string",
            "enum": [
              "PARTIALLY_DISBURSED",
              "LOCKED",
              "LOCKED_CAPPING",
              "REFINANCED",
              "RESCHEDULED",
              "WITHDRAWN",
              "REPAID",
              "REJECTED",
              "WRITTEN_OFF",
              "TERMINATED"
            ]
          },
          "accountHolderType": {
            "type": "string",
            "enum": [
              "CLIENT",
              "GROUP"
            ]
          },
          "accountHolderKey": {
            "type": "string"
          },
          "loanAmount": {
            "type": "number"
          },
          "loanName": {
            "type": "string"
          },
          "daysInArrears": {
            "type": "integer"
          },
          "creationDate": {
            "type": "string"
          },
          "approvedDate": {
            "type": "string"
          },
          "closedDate": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "encodedKey"
        ]
      },
      "DepositAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "encodedKey": {
            "type": "string"
          },
          "accountState": {
            "type": "string",
            "enum": [
              "PENDING_APPROVAL",
              "APPROVED",
              "ACTIVE",
              "ACTIVE_IN_ARREARS",
              "MATURED",
              "LOCKED",
              "DORMANT",
              "CLOSED",
              "CLOSED_WRITTEN_OFF",
              "WITHDRAWN",
              "CLOSED_REJECTED"
            ]
          },
