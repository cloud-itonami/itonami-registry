// Kafka clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace kafka {

    entity Topic {
        id: string @unique
        name: string
        numPartitions: integer
        replicationFactor: integer
        isInternal: boolean
        minInsyncReplicas: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Partition {
        id: string @unique
        topicName: string
        partitionIndex: integer
        leader: integer
        replicas: string
        isr: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity AclBinding {
        id: string @unique
        resourceType: string
        resourceName: string
        principal: string
        host: string
        operation: string
        permissionType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ConsumerGroup {
        id: string @unique
        groupId: string
        protocolType: string
        state: string
        generationId: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity FetchRequest {
        id: string @unique
        topicName: string
        partitionIndex: integer
        fetchOffset: integer
        maxBytes: integer
        isolationLevel: string
        createdAt: datetime
        updatedAt: datetime
    }

}
