          },
          "isInternal": {
            "type": "boolean"
          },
          "minInsyncReplicas": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TopicCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "numPartitions": {
            "type": "integer"
          },
          "replicationFactor": {
            "type": "integer"
          },
          "isInternal": {
            "type": "boolean"
          },
          "minInsyncReplicas": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "numPartitions"
        ]
      },
      "Partition": {
        "type": "object",
