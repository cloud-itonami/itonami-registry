// Databricks clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace databricks {

    entity Cluster {
        id: string @unique
        clusterName: string
        state: string
        sparkVersion: string
        numWorkers: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Job {
        id: string @unique
        jobId: integer
        creatorUserName: string
        createdTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Run {
        id: string @unique
        runId: integer
        jobId: integer
        state: string
        runName: string
        startTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Warehouse {
        id: string @unique
        name: string
        state: string
        warehouseType: string
        clusterSize: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ObjectInfo {
        id: string @unique
        path: string
        objectType: string
        language: string
        size: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
