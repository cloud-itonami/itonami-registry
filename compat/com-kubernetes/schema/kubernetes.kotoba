// Kubernetes clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace kubernetes {

    entity Pod {
        id: string @unique
        name: string
        namespace: string
        phase: string
        nodeName: string
        podIP: string
        qosClass: string
        restartPolicy: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Service {
        id: string @unique
        name: string
        namespace: string
        type: string
        clusterIP: string
        externalName: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Deployment {
        id: string @unique
        name: string
        namespace: string
        replicas: integer
        readyReplicas: integer
        updatedReplicas: integer
        observedGeneration: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Namespace {
        id: string @unique
        name: string
        phase: string
        deletionTimestamp: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Node {
        id: string @unique
        name: string
        address: string
        addressType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity PersistentVolume {
        id: string @unique
        name: string
        phase: string
        message: string
        createdAt: datetime
        updatedAt: datetime
    }

}
