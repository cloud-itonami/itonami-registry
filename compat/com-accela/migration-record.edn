   :after  {0 827109938 1 991960698 2 475448106 3 991960698 4 991960698 5 991960698
            :reading "selector 4 now falls through to the unexpanded floor it shares with 1, 3 and 5, while 0 and 2 stay distinct -- so the oracle still discriminates. Selector 0 moved because cred-row's fields changed; it is a hash of the rendered record."}}
  :builds {:amu-check {:status :ok} :amu-compile {:status :ok :bytes 235837 :target "aarch64-macos"}}
