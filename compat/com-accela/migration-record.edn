  :amu-compile-native {:status :ok :exit 0 :target :aarch64-macos}}

 :executed
 {:harness "cc -O2 amu/tools/kexe_loader.c, then KEXE_FUEL=100000000 ./kexe-loader <sym>.bin <offset> <arity> aarch64 7,23 [args]"
  :main {:value 30 :meaning "route-count: five routes over six entities, computed from the table"}
  :oracle-expand
  {:values {0 303754089 1 499508843 2 701086944 3 499508843 4 303754089 5 499508843}
   :reading
   "Selectors 1, 3 and 5 collapse to 499508843 -- not-a-ref, empty-refs, and no
    expansion at all -- which is the floor that makes the others mean anything.
    Selector 0 expands the one ref and differs. Selector 2 points at a Project
