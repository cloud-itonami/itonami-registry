// Klaviyo clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace klaviyo {

    entity Profile {
        id: string @unique
        email: string
        phoneNumber: string
        externalId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity List {
        id: string @unique
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Segment {
        id: string @unique
        name: string
        isActive: boolean
        isStarred: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Campaign {
        id: string @unique
        name: string
        status: string
        archived: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Flow {
        id: string @unique
        name: string
        status: string
        triggerType: string
        archived: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Event {
        id: string @unique
        metricId: string
        profileId: string
        timestamp: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
