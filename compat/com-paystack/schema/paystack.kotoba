namespace paystack {

    entity Transaction {
        id: string @unique
        email: string
        amount: integer
        reference: string
        callbackUrl: string
        plan: string
        invoiceLimit: integer
        splitCode: string
        subaccount: string
        transactionCharge: string
        bearer: string
        label: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Customer {
        id: string @unique
        email: string
        firstName: string
        lastName: string
        phone: string
        metadata: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Plan {
        id: string @unique
        name: string
        amount: integer
        interval: string
        description: string
        sendInvoices: boolean
        sendSms: boolean
        currency: string
        invoiceLimit: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Subscription {
        id: string @unique
        customer: string
        plan: string
        authorization: string
        startDate: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Product {
        id: string @unique
        name: string
        description: string
        price: integer
        currency: string
        unlimited: boolean
        quantity: integer
        splitCode: string
        metadata: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Page {
        id: string @unique
        name: string
        description: string
        amount: integer
        currency: string
        slug: string
        type: string
        plan: string
        fixedAmount: boolean
        splitCode: string
        redirectUrl: string
        successMessage: string
        notificationEmail: string
        collectPhone: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
