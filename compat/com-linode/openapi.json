  "components": {
    "schemas": {
      "Instance": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "offline",
              "booting",
              "busy",
