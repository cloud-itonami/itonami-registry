namespace gbfs {

    entity SystemInformation {
        id: string @unique
        systemId: string
        name: string
        operator: string
        url: string
        timezone: string
        openingHours: string
        phoneNumber: string
        email: string
        feedContactEmail: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity VehicleType {
        id: string @unique
        vehicleTypeId: string
        formFactor: string
        propulsionType: string
        returnConstraint: string
        maxRangeMeters: float
        riderCapacity: integer
        wheelCount: integer
        maxPermittedSpeed: integer
        minAge: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Station {
        id: string @unique
        stationId: string
        name: string
        lat: float
        lon: float
        address: string
        city: string
        regionId: string
        capacity: integer
        isVirtualStation: boolean
        isChargingStation: boolean
        parkingType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity StationStatus {
        id: string @unique
        stationId: string
        numVehiclesAvailable: integer
        numDocksAvailable: integer
        isInstalled: boolean
        isRenting: boolean
        isReturning: boolean
        lastReported: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Vehicle {
        id: string @unique
        vehicleId: string
        lat: float
        lon: float
        isReserved: boolean
        isDisabled: boolean
        vehicleTypeId: string
        currentRangeMeters: float
        lastReported: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Region {
        id: string @unique
        regionId: string
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

}
