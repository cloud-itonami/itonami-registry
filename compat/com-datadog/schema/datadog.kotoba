// Datadog clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace datadog {

    entity Monitor {
        id: string @unique
        name: string
        type: string
        query: string
        message: string
        overallState: string
        tags: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Dashboard {
        id: string @unique
        title: string
        layoutType: string
        description: string
        widgets: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity TimeSeries {
        id: string @unique
        metric: string
        type: string
        timestamp: integer
        value: float
        host: string
        tags: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Event {
        id: string @unique
        title: string
        text: string
        timestamp: integer
        priority: string
        alertType: string
        tags: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Downtime {
        id: string @unique
        monitorId: integer
        scope: string
        start: integer
        end: integer
        timezone: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Incident {
        id: string @unique
        title: string
        severity: string
        status: string
        customerImpactScope: string
        createdAt: datetime
        updatedAt: datetime
    }

}
