// Shippo clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace shippo {

    entity Address {
        id: string @unique
        name: string
        company: string
        street1: string
        city: string
        state: string
        zip: string
        country: string
        phone: string
        email: string
        isResidential: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Parcel {
        id: string @unique
        objectId: string
        weight: string
        massUnit: string
        length: string
        width: string
        height: string
        distanceUnit: string
        objectCreated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Shipment {
        id: string @unique
        objectId: string
        status: string
        addressFrom: string
        addressTo: string
        shipmentDate: datetime
        objectCreated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Rate {
        id: string @unique
        objectId: string
        amount: string
        currency: string
        carrierAccount: string
        servicelevelToken: string
        estimatedDays: integer
        objectCreated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Transaction {
        id: string @unique
        objectId: string
        status: string
        objectState: string
        trackingNumber: string
        trackingStatus: string
        labelUrl: string
        labelFileType: string
        rate: string
        test: boolean
        objectCreated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity TrackingStatus {
        id: string @unique
        objectId: string
        status: string
        statusDetails: string
        substatus: string
        statusDate: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
