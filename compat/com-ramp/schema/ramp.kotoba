        email: string
        firstName: string
        lastName: string
        role: string
        status: string
        departmentID: string
        isManager: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Department {
        id: string @unique
        id: string
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Reimbursement {
        id: string @unique
        id: string
        state: string
        amount: float
        currency: string
        type: string
        userID: string
        direction: string
        createdAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Bill {
        id: string @unique
        id: string
        status: string
        amount: integer
        currencyCode: string
        invoiceNumber: string
