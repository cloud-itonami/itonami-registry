  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CHIP_LOCKED",
              "SUSPENDED",
              "TERMINATED",
              "UNACTIVATED"
            ]
          },
          "lastFour": {
            "type": "string"
