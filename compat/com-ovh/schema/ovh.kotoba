// Ovh clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace ovh {

    entity Project {
        id: string @unique
        name: string
        region: string
        billingId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ComputeInstance {
        id: string @unique
        projectId: string
        name: string
        machineType: string
        state: string
        ipAddress: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Volume {
        id: string @unique
        projectId: string
        sizeGb: integer
        type: string
        attachedTo: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Bucket {
        id: string @unique
        projectId: string
        name: string
        region: string
        public: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Network {
        id: string @unique
        projectId: string
        cidr: string
        region: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity IamRole {
        id: string @unique
        projectId: string
        name: string
        policy: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
