        lastName: string
        email: string
        isCreator: boolean
        isEmailVerified: boolean
        likeCount: integer
        created: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Member {
        id: string @unique
        id: string
        patronStatus: string
        lastChargeStatus: string
