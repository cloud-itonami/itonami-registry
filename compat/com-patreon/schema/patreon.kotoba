        lastChargeDate: datetime
        nextChargeDate: datetime
        pledgeRelationshipStart: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Campaign {
        id: string @unique
        id: string
        creationName: string
        currency: string
        name: string
        patronCount: integer
        payPerName: string
        isMonthly: boolean
        isNsfw: boolean
        createdAt: datetime
        publishedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Tier {
        id: string @unique
        id: string
        amountCents: integer
        description: string
        patronCount: integer
        published: boolean
        requiresShipping: boolean
        title: string
        createdAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Benefit {
        id: string @unique
        id: string
        benefitType: string
        description: string
        isDeleted: boolean
        isPublished: boolean
        title: string
        tiersCount: integer
        createdAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

