// cerebras_wafer clean-room schema -> Datomic EAVT mapping
// Wafer-scale AI accelerator design.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace cerebras_wafer {

    entity WaferEngine {
        id: string @unique
        name: string
        generation: string
        coreCount: integer
        sramGb: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity ProcessingElement {
        id: string @unique
        engineId: string
        dataflow: string
        flops: float
        localSramKb: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Fabric {
        id: string @unique
        engineId: string
        topology: string
        bisectionBwTbps: float
        latencyNs: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity MemoryBank {
        id: string @unique
        engineId: string
        sizeGb: integer
        bandwidthTbps: float
        kind: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Kernel {
        id: string @unique
        engineId: string
        name: string
        tiles: integer
        occupancy: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity WaferJob {
        id: string @unique
        engineId: string
        model: string
        tokensPerSec: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
