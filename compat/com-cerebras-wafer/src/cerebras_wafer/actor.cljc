                   (cond-> (contains? data :engineId) (conj [:db/add id :cerebras_wafer.Kernel/engineId (get data :engineId)]))
                   (cond-> (contains? data :name) (conj [:db/add id :cerebras_wafer.Kernel/name (get data :name)]))
                   (cond-> (contains? data :tiles) (conj [:db/add id :cerebras_wafer.Kernel/tiles (as-long (get data :tiles))]))
                   (cond-> (contains? data :occupancy) (conj [:db/add id :cerebras_wafer.Kernel/occupancy (as-double (get data :occupancy))]))
                   (conj [:db/add id :cerebras_wafer.Kernel/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-kernel
  "Delete a Kernel."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

;; ── WaferJob ────────────────────────────────────────────────────────────────
(defn create-wafer-job
  "Create a WaferJob."
  [port data]
  (require-fields data ["model" "tokensPerSec"])
  (let [id (new-id "cs_waf")
        e {:db/id id
           :cerebras_wafer.WaferJob/id id
           :cerebras_wafer.WaferJob/engineId (get data :engineId)
           :cerebras_wafer.WaferJob/model (get data :model)
           :cerebras_wafer.WaferJob/tokensPerSec (as-double (get data :tokensPerSec))
           :cerebras_wafer.WaferJob/status (get data :status)
           :cerebras_wafer.WaferJob/createdAt (now)
           :cerebras_wafer.WaferJob/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-wafer-jobs
  "List WaferJob with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-wafer-jobs port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :cerebras_wafer.WaferJob/id))
         rows (apply-filters rows (:filter opts) [:cerebras_wafer.WaferJob/engineId :cerebras_wafer.WaferJob/model :cerebras_wafer.WaferJob/tokensPerSec :cerebras_wafer.WaferJob/status])]
     (paginate rows opts))))

(defn get-wafer-job
  "Retrieve a WaferJob by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-wafer-job port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-wafer-job
  "Update a WaferJob; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :engineId) (conj [:db/add id :cerebras_wafer.WaferJob/engineId (get data :engineId)]))
                   (cond-> (contains? data :model) (conj [:db/add id :cerebras_wafer.WaferJob/model (get data :model)]))
                   (cond-> (contains? data :tokensPerSec) (conj [:db/add id :cerebras_wafer.WaferJob/tokensPerSec (as-double (get data :tokensPerSec))]))
                   (cond-> (contains? data :status) (conj [:db/add id :cerebras_wafer.WaferJob/status (get data :status)]))
                   (conj [:db/add id :cerebras_wafer.WaferJob/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-wafer-job
  "Delete a WaferJob."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

