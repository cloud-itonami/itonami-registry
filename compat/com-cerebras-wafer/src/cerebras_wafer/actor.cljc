(defn create-wafer-engine
  "Create a WaferEngine."
  [port data]
  (require-fields data ["name" "generation"])
  (let [id (new-id "cs_waf")
        e {:db/id id
           :cerebras_wafer.WaferEngine/id id
           :cerebras_wafer.WaferEngine/name (get data :name)
           :cerebras_wafer.WaferEngine/generation (get data :generation)
           :cerebras_wafer.WaferEngine/coreCount (as-long (get data :coreCount))
           :cerebras_wafer.WaferEngine/sramGb (as-long (get data :sramGb))
           :cerebras_wafer.WaferEngine/createdAt (now)
           :cerebras_wafer.WaferEngine/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-wafer-engines
  "List WaferEngine with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-wafer-engines port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :cerebras_wafer.WaferEngine/id))
         rows (apply-filters rows (:filter opts) [:cerebras_wafer.WaferEngine/name :cerebras_wafer.WaferEngine/generation :cerebras_wafer.WaferEngine/coreCount :cerebras_wafer.WaferEngine/sramGb])]
     (paginate rows opts))))

(defn get-wafer-engine
  "Retrieve a WaferEngine by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-wafer-engine port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-wafer-engine
  "Update a WaferEngine; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :name) (conj [:db/add id :cerebras_wafer.WaferEngine/name (get data :name)]))
                   (cond-> (contains? data :generation) (conj [:db/add id :cerebras_wafer.WaferEngine/generation (get data :generation)]))
                   (cond-> (contains? data :coreCount) (conj [:db/add id :cerebras_wafer.WaferEngine/coreCount (as-long (get data :coreCount))]))
                   (cond-> (contains? data :sramGb) (conj [:db/add id :cerebras_wafer.WaferEngine/sramGb (as-long (get data :sramGb))]))
                   (conj [:db/add id :cerebras_wafer.WaferEngine/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-wafer-engine
  "Delete a WaferEngine."
