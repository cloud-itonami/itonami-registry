// Mailchimp clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace mailchimp {

    entity List {
        id: string @unique
        name: string
        permissionReminder: string
        useArchiveBar: boolean
        notifyOnSubscribe: boolean
        notifyOnUnsubscribe: boolean
        listRating: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity ListMember {
        id: string @unique
        emailAddress: string
        emailType: string
        status: string
        language: string
        vip: boolean
        memberRating: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Campaign {
        id: string @unique
        type: string
        contentType: string
        status: string
        emailTitle: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Template {
        id: string @unique
        name: string
        type: string
        folderId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Segment {
        id: string @unique
        name: string
        type: string
        memberCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Automation {
        id: string @unique
        workflowId: string
        type: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}
