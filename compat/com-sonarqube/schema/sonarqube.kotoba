// Sonarqube clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace sonarqube {

    entity Issue {
        id: string @unique
        key: string
        severity: string
        status: string
        type: string
        resolution: string
        component: string
        line: integer
        message: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Hotspot {
        id: string @unique
        key: string
        status: string
        message: string
        component: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity QualityGate {
        id: string @unique
        status: string
        ignoredConditions: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Condition {
        id: string @unique
        status: string
        metricKey: string
        comparator: string
        errorThreshold: string
        actualValue: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Measure {
        id: string @unique
        metric: string
        value: string
        bestValue: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
