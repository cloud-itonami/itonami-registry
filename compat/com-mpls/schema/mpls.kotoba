// Mpls clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace mpls {

    entity LabelStackEntry {
        id: string @unique
        label: integer
        tc: integer
        s: boolean
        ttl: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity MplsHeader {
        id: string @unique
        stackDepth: integer
        topLabel: integer
        trafficClass: integer
        bottomOfStack: boolean
        timeToLive: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity ReservedLabel {
        id: string @unique
        value: integer
        name: string
        purpose: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity NhlfeOperation {
        id: string @unique
        operationType: string
        newLabel: integer
        nextHopDestination: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity MplsForwardingState {
        id: string @unique
        incomingLabel: integer
        fecRef: string
        hopCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
