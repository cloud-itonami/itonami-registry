// Typeform clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace typeform {

    entity Form {
        id: string @unique
        id: string
        title: string
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Field {
        id: string @unique
        ref: string
        id: string
        title: string
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Response {
        id: string @unique
        token: string
        landedAt: datetime
        submittedAt: datetime
        formId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Answer {
        id: string @unique
        fieldId: string
        fieldType: string
        type: string
        value: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Webhook {
        id: string @unique
        eventId: string
        eventType: string
        timestamp: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
