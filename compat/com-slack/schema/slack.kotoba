// Slack clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace slack {

    entity Channel {
        id: string @unique
        name: string
        isPrivate: boolean
        topic: string
        memberCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Message {
        id: string @unique
        channelId: string
        userId: string
        text: string
        ts: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        handle: string
        realName: string
        email: string
        isBot: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Conversation {
        id: string @unique
        type: string
        creatorId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity File {
        id: string @unique
        name: string
        mimeType: string
        sizeBytes: integer
        uploaderId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Reaction {
        id: string @unique
        messageTs: string
        name: string
        count: integer
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
