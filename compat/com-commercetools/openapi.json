  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "orderNumber": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "customerEmail": {
            "type": "string"
          },
          "orderState": {
            "type": "string",
            "enum": [
              "Open",
              "Confirmed",
              "Complete",
              "Cancelled"
