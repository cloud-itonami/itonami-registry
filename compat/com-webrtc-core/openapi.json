  "components": {
    "schemas": {
      "RTCPeerConnection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "signalingState": {
            "type": "string",
            "enum": [
              "stable",
              "have-local-offer",
              "have-remote-offer",
              "have-local-pranswer",
              "have-remote-pranswer",
              "closed"
            ]
          },
          "iceConnectionState": {
            "type": "string",
            "enum": [
              "new",
              "checking",
              "connected",
              "completed",
              "failed",
              "disconnected",
              "closed"
            ]
          },
          "iceGatheringState": {
            "type": "string",
            "enum": [
              "new",
              "gathering",
              "complete"
            ]
          },
          "connectionState": {
            "type": "string",
            "enum": [
              "new",
              "connecting",
              "connected",
              "disconnected",
              "failed",
              "closed"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RTCPeerConnectionCreate": {
        "type": "object",
        "properties": {
          "signalingState": {
            "type": "string",
            "enum": [
              "stable",
              "have-local-offer",
              "have-remote-offer",
              "have-local-pranswer",
              "have-remote-pranswer",
              "closed"
            ]
          },
          "iceConnectionState": {
            "type": "string",
            "enum": [
              "new",
              "checking",
              "connected",
              "completed",
              "failed",
              "disconnected",
              "closed"
            ]
          },
          "iceGatheringState": {
            "type": "string",
            "enum": [
              "new",
              "gathering",
              "complete"
            ]
          },
          "connectionState": {
            "type": "string",
            "enum": [
              "new",
              "connecting",
              "connected",
              "disconnected",
              "failed",
              "closed"
            ]
          }
        },
        "required": [
          "signalingState",
          "iceConnectionState"
        ]
      },
      "RTCDataChannel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "ordered": {
            "type": "boolean"
          },
          "protocol": {
            "type": "string"
          },
          "negotiated": {
            "type": "boolean"
          },
          "readyState": {
            "type": "string",
            "enum": [
              "connecting",
              "open",
              "closing",
              "closed"
            ]
          },
          "bufferedAmount": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RTCDataChannelCreate": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "ordered": {
            "type": "boolean"
          },
          "protocol": {
            "type": "string"
          },
          "negotiated": {
            "type": "boolean"
          },
          "id": {
            "type": "integer"
          },
          "readyState": {
            "type": "string",
            "enum": [
              "connecting",
              "open",
              "closing",
              "closed"
            ]
          },
          "bufferedAmount": {
            "type": "integer"
          }
