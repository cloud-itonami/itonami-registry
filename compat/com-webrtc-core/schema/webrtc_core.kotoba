        address: string
        type: string
        tcpType: string
        priority: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity RTCRtpTransceiver {
        id: string @unique
        mid: string
        direction: string
        currentDirection: string
        createdAt: datetime
        updatedAt: datetime
    }

}
