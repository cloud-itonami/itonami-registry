        price: float
        availability: string
        condition: string
        inventoryTracking: string
        isVisible: boolean
        dateCreated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Order {
        id: string @unique
        id: integer
        customerId: integer
        email: string
        status: string
        total: float
        subtotal: float
        currencyCode: string
        paymentMethod: string
        dateCreated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Customer {
        id: string @unique
        id: integer
        email: string
        firstName: string
        lastName: string
        company: string
        phone: string
        customerGroupId: integer
        dateCreated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Category {
        id: string @unique
        id: integer
        name: string
        parentId: integer
        description: string
        isVisible: boolean
        sortOrder: integer
        defaultProductSort: string
        createdAt: datetime
