    }

    entity Brand {
        id: string @unique
        id: integer
        name: string
        pageTitle: string
        searchKeywords: string
        imageUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Cart {
        id: string @unique
        id: string
        customerId: integer
        email: string
        channelId: integer
        baseAmount: float
