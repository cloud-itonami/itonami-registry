namespace marqeta {

    entity Card {
        id: string @unique
        token: string
        state: string
        lastFour: string
        cardProductToken: string
        userToken: string
        fulfillmentStatus: string
        createdTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity CardProduct {
        id: string @unique
        token: string
        name: string
        active: boolean
        createdTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        token: string
        firstName: string
        lastName: string
        email: string
        status: string
        active: boolean
        createdTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Transaction {
        id: string @unique
        token: string
        amount: float
        type: string
        state: string
        cardToken: string
        userToken: string
        createdTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity FundingSource {
        id: string @unique
        token: string
        type: string
        active: boolean
        isDefaultAccount: boolean
        createdTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
