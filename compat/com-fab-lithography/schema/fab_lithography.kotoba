// fab_lithography clean-room schema -> Datomic EAVT mapping
// Semiconductor fab / EUV lithography process.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace fab_lithography {

    entity Wafer {
        id: string @unique
        lotId: string
        diameterMm: integer
        processNode: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ProcessStep {
        id: string @unique
        waferId: string
        name: string
        tool: string
        stepType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Reticle {
        id: string @unique
        name: string
        layer: string
        euv: boolean
        numericalAperture: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity ProcessRecipe {
        id: string @unique
        stepId: string
        name: string
        doseMjCm2: float
        focusNm: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity DefectScan {
        id: string @unique
        waferId: string
        defectCount: integer
        defectDensity: float
        classification: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Yield {
        id: string @unique
        waferId: string
        dieTotal: integer
        dieGood: integer
        yieldPct: float
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
