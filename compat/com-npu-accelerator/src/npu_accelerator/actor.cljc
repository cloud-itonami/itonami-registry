   "systolicarrays" {:create create-systolic-array :list list-systolic-arrays :get get-systolic-array :update update-systolic-array :delete delete-systolic-array}
   "macunits" {:create create-mac-unit :list list-mac-units :get get-mac-unit :update update-mac-unit :delete delete-mac-unit}
