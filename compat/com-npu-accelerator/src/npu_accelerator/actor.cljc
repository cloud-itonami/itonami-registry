                   (cond-> (contains? data :kind) (conj [:db/add id :npu_accelerator.Dataflow/kind (get data :kind)]))
                   (cond-> (contains? data :reuse) (conj [:db/add id :npu_accelerator.Dataflow/reuse (get data :reuse)]))
                   (conj [:db/add id :npu_accelerator.Dataflow/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-dataflow
  "Delete a Dataflow."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

;; ── InferenceTask ────────────────────────────────────────────────────────────────
(defn create-inference-task
  "Create a InferenceTask."
  [port data]
  (require-fields data ["model" "batchSize"])
  (let [id (new-id "npu_inf")
        e {:db/id id
           :npu_accelerator.InferenceTask/id id
           :npu_accelerator.InferenceTask/npuId (get data :npuId)
           :npu_accelerator.InferenceTask/model (get data :model)
           :npu_accelerator.InferenceTask/batchSize (as-long (get data :batchSize))
           :npu_accelerator.InferenceTask/status (get data :status)
           :npu_accelerator.InferenceTask/createdAt (now)
           :npu_accelerator.InferenceTask/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-inference-tasks
  "List InferenceTask with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-inference-tasks port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :npu_accelerator.InferenceTask/id))
         rows (apply-filters rows (:filter opts) [:npu_accelerator.InferenceTask/npuId :npu_accelerator.InferenceTask/model :npu_accelerator.InferenceTask/batchSize :npu_accelerator.InferenceTask/status])]
     (paginate rows opts))))

(defn get-inference-task
  "Retrieve a InferenceTask by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-inference-task port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec
         (and want (contains? want :npuId) (get rec :npu_accelerator.InferenceTask/npuId))
         (assoc :npuId-obj (-pull port (get rec :npu_accelerator.InferenceTask/npuId))))))))

(defn update-inference-task
  "Update a InferenceTask; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :npuId) (conj [:db/add id :npu_accelerator.InferenceTask/npuId (get data :npuId)]))
                   (cond-> (contains? data :model) (conj [:db/add id :npu_accelerator.InferenceTask/model (get data :model)]))
                   (cond-> (contains? data :batchSize) (conj [:db/add id :npu_accelerator.InferenceTask/batchSize (as-long (get data :batchSize))]))
                   (cond-> (contains? data :status) (conj [:db/add id :npu_accelerator.InferenceTask/status (get data :status)]))
                   (conj [:db/add id :npu_accelerator.InferenceTask/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-inference-task
  "Delete a InferenceTask."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

