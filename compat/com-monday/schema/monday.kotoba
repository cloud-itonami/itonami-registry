// Monday clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace monday {

    entity Board {
        id: string @unique
        name: string
        description: string
        state: string
        boardKind: string
        itemsCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Item {
        id: string @unique
        name: string
        email: string
        creatorId: string
        state: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Column {
        id: string @unique
        title: string
        description: string
        type: string
        archived: boolean
        width: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Group {
        id: string @unique
        title: string
        color: string
        position: string
        archived: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        name: string
        email: string
        enabled: boolean
        isAdmin: boolean
        isGuest: boolean
        countryCode: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Update {
        id: string @unique
        body: string
        textBody: string
        creatorId: string
        itemId: string
        createdAt: datetime
        updatedAt: datetime
    }

}
