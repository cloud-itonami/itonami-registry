namespace greenhouse {

    entity Candidate {
        id: string @unique
        firstName: string
        lastName: string
        email: string
        canEmail: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Application {
        id: string @unique
        candidateId: string
        prospect: boolean
        appliedAt: datetime
        status: string
        jobPostId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Job {
        id: string @unique
        name: string
        requisitionId: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Offer {
        id: string @unique
        applicationId: string
        candidateId: string
        jobId: string
        status: string
        startDate: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Scorecard {
        id: string @unique
        applicationId: string
        interviewerId: string
        score: string
        notes: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ScheduledInterview {
        id: string @unique
        applicationId: string
        name: string
        scheduledAt: datetime
        videoConferencingUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

}
