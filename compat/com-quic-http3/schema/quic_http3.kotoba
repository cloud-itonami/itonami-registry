namespace quic_http3 {

    entity QuicPacket {
        id: string @unique
        packetType: string
        version: integer
        sourceConnectionId: string
        destinationConnectionId: string
        payloadLength: integer
        packetNumber: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity QuicFrame {
        id: string @unique
        frameType: integer
        payload: string
        streamId: integer
        offsetInStream: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Http3Frame {
        id: string @unique
        frameType: integer
        length: integer
        payload: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Http3Settings {
        id: string @unique
        identifier: integer
        value: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity QuicConnection {
        id: string @unique
        connectionId: string
        version: integer
        state: string
        createdAt: datetime
        lastActivityAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
