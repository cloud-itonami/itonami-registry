(defn create-photonic-processor
  "Create a PhotonicProcessor."
  [port data]
  (require-fields data ["name" "platform"])
  (let [id (new-id "opc_pho")
        e {:db/id id
           :optical_compute.PhotonicProcessor/id id
           :optical_compute.PhotonicProcessor/name (get data :name)
           :optical_compute.PhotonicProcessor/platform (get data :platform)
           :optical_compute.PhotonicProcessor/topsPerWatt (as-double (get data :topsPerWatt))
           :optical_compute.PhotonicProcessor/wavelengths (as-long (get data :wavelengths))
           :optical_compute.PhotonicProcessor/createdAt (now)
           :optical_compute.PhotonicProcessor/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-photonic-processors
  "List PhotonicProcessor with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-photonic-processors port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :optical_compute.PhotonicProcessor/id))
         rows (apply-filters rows (:filter opts) [:optical_compute.PhotonicProcessor/name :optical_compute.PhotonicProcessor/platform :optical_compute.PhotonicProcessor/topsPerWatt :optical_compute.PhotonicProcessor/wavelengths])]
     (paginate rows opts))))

(defn get-photonic-processor
  "Retrieve a PhotonicProcessor by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-photonic-processor port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-photonic-processor
  "Update a PhotonicProcessor; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :name) (conj [:db/add id :optical_compute.PhotonicProcessor/name (get data :name)]))
                   (cond-> (contains? data :platform) (conj [:db/add id :optical_compute.PhotonicProcessor/platform (get data :platform)]))
                   (cond-> (contains? data :topsPerWatt) (conj [:db/add id :optical_compute.PhotonicProcessor/topsPerWatt (as-double (get data :topsPerWatt))]))
                   (cond-> (contains? data :wavelengths) (conj [:db/add id :optical_compute.PhotonicProcessor/wavelengths (as-long (get data :wavelengths))]))
                   (conj [:db/add id :optical_compute.PhotonicProcessor/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-photonic-processor
  "Delete a PhotonicProcessor."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

