;; collection → CRUD fns, keyed by the /v1/<collection> path segment
(def ^:private handlers
  {"photonicprocessors" {:create create-photonic-processor :list list-photonic-processors :get get-photonic-processor :update update-photonic-processor :delete delete-photonic-processor}
   "mzimeshes" {:create create-mzi-mesh :list list-mzi-meshes :get get-mzi-mesh :update update-mzi-mesh :delete delete-mzi-mesh}
   "opticalcores" {:create create-optical-core :list list-optical-cores :get get-optical-core :update update-optical-core :delete delete-optical-core}
   "nonlinearunits" {:create create-nonlinear-unit :list list-nonlinear-units :get get-nonlinear-unit :update update-nonlinear-unit :delete delete-nonlinear-unit}
   "wdmbuses" {:create create-wdm-bus :list list-wdm-buses :get get-wdm-bus :update update-wdm-bus :delete delete-wdm-bus}
   "computetiles" {:create create-compute-tile :list list-compute-tiles :get get-compute-tile :update update-compute-tile :delete delete-compute-tile}})

(defn- expand-opts [params]
  (when-let [x (:expand params)]
    {:expand (set (map keyword (str/split (str x) #",")))}))

(defn dispatch
  "Route an HTTP-ish request through `routes` to the CRUD fns.
   req: {:method (:get/:post/:patch/:delete) :path /v1/<coll>[/<id>] :params {} :body {}}.
   Returns {:status int :body any} — the runnable L4 service surface."
  [port {:keys [method path params body]}]
  (let [segs (->> (str/split (or path "") #"/") (remove str/blank?) vec)
        coll (get segs 1)
        id   (get segs 2)
        h    (get handlers coll)
        params (or params {})]
    (cond
      (nil? h) {:status 404 :body {:error "unknown collection"}}
      (and (= method :post) (nil? id)) {:status 201 :body ((:create h) port (or body params))}
      (and (= method :get) (nil? id)) {:status 200 :body ((:list h) port params)}
      (and (= method :get) id) (if-let [r ((:get h) port id (expand-opts params))]
                                 {:status 200 :body r} {:status 404 :body {:error "not found"}})
      (and (#{:patch :put} method) id) (if-let [r ((:update h) port id (or body params))]
                                         {:status 200 :body r} {:status 404 :body {:error "not found"}})
      (and (= method :delete) id) {:status 200 :body ((:delete h) port id)}
      :else {:status 405 :body {:error "method not allowed"}})))

