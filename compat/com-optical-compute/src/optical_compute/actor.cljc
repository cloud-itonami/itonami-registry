  [port data]
  (require-fields data ["index" "utilization"])
  (let [id (new-id "opc_com")
        e {:db/id id
           :optical_compute.ComputeTile/id id
           :optical_compute.ComputeTile/processorId (get data :processorId)
           :optical_compute.ComputeTile/index (as-long (get data :index))
           :optical_compute.ComputeTile/utilization (as-double (get data :utilization))
           :optical_compute.ComputeTile/status (get data :status)
           :optical_compute.ComputeTile/createdAt (now)
           :optical_compute.ComputeTile/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-compute-tiles
  "List ComputeTile with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-compute-tiles port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :optical_compute.ComputeTile/id))
         rows (apply-filters rows (:filter opts) [:optical_compute.ComputeTile/processorId :optical_compute.ComputeTile/index :optical_compute.ComputeTile/utilization :optical_compute.ComputeTile/status])]
     (paginate rows opts))))

(defn get-compute-tile
  "Retrieve a ComputeTile by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-compute-tile port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-compute-tile
  "Update a ComputeTile; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :processorId) (conj [:db/add id :optical_compute.ComputeTile/processorId (get data :processorId)]))
                   (cond-> (contains? data :index) (conj [:db/add id :optical_compute.ComputeTile/index (as-long (get data :index))]))
                   (cond-> (contains? data :utilization) (conj [:db/add id :optical_compute.ComputeTile/utilization (as-double (get data :utilization))]))
                   (cond-> (contains? data :status) (conj [:db/add id :optical_compute.ComputeTile/status (get data :status)]))
                   (conj [:db/add id :optical_compute.ComputeTile/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-compute-tile
  "Delete a ComputeTile."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

