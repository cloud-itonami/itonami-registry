// optical_compute clean-room schema -> Datomic EAVT mapping
// Photonic computing / optical matrix-multiply 光電融合.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace optical_compute {

    entity PhotonicProcessor {
        id: string @unique
        name: string
        platform: string
        topsPerWatt: float
        wavelengths: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity MziMesh {
        id: string @unique
        processorId: string
        rows: integer
        columns: integer
        phaseShifter: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity OpticalCore {
        id: string @unique
        processorId: string
        macsPerCycle: integer
        precisionBits: integer
        clockGhz: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity NonlinearUnit {
        id: string @unique
        coreId: string
        activation: string
        thresholdMw: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity WdmBus {
        id: string @unique
        processorId: string
        channels: integer
        spacingGhz: float
        aggregateTbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity ComputeTile {
        id: string @unique
        processorId: string
        index: integer
        utilization: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
