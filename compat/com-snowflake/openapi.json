  "components": {
    "schemas": {
      "Warehouse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "warehouseType": {
            "type": "string",
            "enum": [
              "STANDARD",
              "SNOWPARK-OPTIMIZED"
            ]
          },
          "warehouseSize": {
            "type": "string",
            "enum": [
              "XSMALL",
