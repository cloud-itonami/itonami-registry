        value: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ResponseCode {
        id: string @unique
        code: string
        meaning: string
        requiresCardPickup: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
