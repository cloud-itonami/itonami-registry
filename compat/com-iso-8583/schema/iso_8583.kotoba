        messageFunction: string
        messageOrigin: string
        version: string
        stan: string
        processingCode: string
        transmissionDateTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity ProcessingCode {
        id: string @unique
        transactionType: string
        accountTypeFrom: string
        accountTypeTo: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity DataElement {
        id: string @unique
        fieldNumber: integer
        name: string
