// gddr_memory clean-room schema -> Datomic EAVT mapping
// GDDR6 / GDDR7 graphics memory design.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace gddr_memory {

    entity GddrDevice {
        id: string @unique
        partNumber: string
        generation: string
        capacityGb: integer
        dataRateGbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity MemoryChannel {
        id: string @unique
        deviceId: string
        width: integer
        prefetch: integer
        dataRateGbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity SignalingMode {
        id: string @unique
        deviceId: string
        scheme: string
        levels: integer
        eyeHeightMv: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity ThermalProfile {
        id: string @unique
        deviceId: string
        tjMaxC: float
        powerW: float
        throttle: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity SpeedGrade {
        id: string @unique
        deviceId: string
        grade: string
        voltage: float
        dataRateGbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity TestBin {
        id: string @unique
        deviceId: string
        binCode: string
        yield: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
