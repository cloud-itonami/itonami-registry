                   (cond-> (contains? data :deviceId) (conj [:db/add id :gddr_memory.SpeedGrade/deviceId (get data :deviceId)]))
                   (cond-> (contains? data :grade) (conj [:db/add id :gddr_memory.SpeedGrade/grade (get data :grade)]))
                   (cond-> (contains? data :voltage) (conj [:db/add id :gddr_memory.SpeedGrade/voltage (as-double (get data :voltage))]))
                   (cond-> (contains? data :dataRateGbps) (conj [:db/add id :gddr_memory.SpeedGrade/dataRateGbps (as-double (get data :dataRateGbps))]))
                   (conj [:db/add id :gddr_memory.SpeedGrade/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

