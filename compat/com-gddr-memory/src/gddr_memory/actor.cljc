(defn create-test-bin
  "Create a TestBin."
  [port data]
  (require-fields data ["binCode" "yield"])
  (let [id (new-id "gddr_tes")
        e {:db/id id
           :gddr_memory.TestBin/id id
           :gddr_memory.TestBin/deviceId (get data :deviceId)
           :gddr_memory.TestBin/binCode (get data :binCode)
           :gddr_memory.TestBin/yield (as-double (get data :yield))
           :gddr_memory.TestBin/status (get data :status)
           :gddr_memory.TestBin/createdAt (now)
           :gddr_memory.TestBin/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-test-bins
  "List TestBin with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-test-bins port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :gddr_memory.TestBin/id))
         rows (apply-filters rows (:filter opts) [:gddr_memory.TestBin/deviceId :gddr_memory.TestBin/binCode :gddr_memory.TestBin/yield :gddr_memory.TestBin/status])]
     (paginate rows opts))))

(defn get-test-bin
  "Retrieve a TestBin by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-test-bin port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-test-bin
