;; collection → CRUD fns, keyed by the /v1/<collection> path segment
(def ^:private handlers
  {"gddrdevices" {:create create-gddr-device :list list-gddr-devices :get get-gddr-device :update update-gddr-device :delete delete-gddr-device}
   "memorychannels" {:create create-memory-channel :list list-memory-channels :get get-memory-channel :update update-memory-channel :delete delete-memory-channel}
   "signalingmodes" {:create create-signaling-mode :list list-signaling-modes :get get-signaling-mode :update update-signaling-mode :delete delete-signaling-mode}
   "thermalprofiles" {:create create-thermal-profile :list list-thermal-profiles :get get-thermal-profile :update update-thermal-profile :delete delete-thermal-profile}
   "speedgrades" {:create create-speed-grade :list list-speed-grades :get get-speed-grade :update update-speed-grade :delete delete-speed-grade}
   "testbins" {:create create-test-bin :list list-test-bins :get get-test-bin :update update-test-bin :delete delete-test-bin}})

(defn- expand-opts [params]
  (when-let [x (:expand params)]
    {:expand (set (map keyword (str/split (str x) #",")))}))

(defn dispatch
  "Route an HTTP-ish request through `routes` to the CRUD fns.
   req: {:method (:get/:post/:patch/:delete) :path /v1/<coll>[/<id>] :params {} :body {}}.
   Returns {:status int :body any} — the runnable L4 service surface."
  [port {:keys [method path params body]}]
  (let [segs (->> (str/split (or path "") #"/") (remove str/blank?) vec)
        coll (get segs 1)
        id   (get segs 2)
        h    (get handlers coll)
        params (or params {})]
    (cond
      (nil? h) {:status 404 :body {:error "unknown collection"}}
      (and (= method :post) (nil? id)) {:status 201 :body ((:create h) port (or body params))}
      (and (= method :get) (nil? id)) {:status 200 :body ((:list h) port params)}
      (and (= method :get) id) (if-let [r ((:get h) port id (expand-opts params))]
                                 {:status 200 :body r} {:status 404 :body {:error "not found"}})
      (and (#{:patch :put} method) id) (if-let [r ((:update h) port id (or body params))]
                                         {:status 200 :body r} {:status 404 :body {:error "not found"}})
      (and (= method :delete) id) {:status 200 :body ((:delete h) port id)}
      :else {:status 405 :body {:error "method not allowed"}})))

