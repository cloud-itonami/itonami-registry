                   (cond-> (contains? data :deviceId) (conj [:db/add id :gddr_memory.TestBin/deviceId (get data :deviceId)]))
                   (cond-> (contains? data :binCode) (conj [:db/add id :gddr_memory.TestBin/binCode (get data :binCode)]))
                   (cond-> (contains? data :yield) (conj [:db/add id :gddr_memory.TestBin/yield (as-double (get data :yield))]))
                   (cond-> (contains? data :status) (conj [:db/add id :gddr_memory.TestBin/status (get data :status)]))
                   (conj [:db/add id :gddr_memory.TestBin/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

