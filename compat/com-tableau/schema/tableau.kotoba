// Tableau clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace tableau {

    entity Dataset {
        id: string @unique
        name: string
        source: string
        schemaRef: string
        rowCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Query {
        id: string @unique
        datasetId: string
        sql: string
        ownerId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Dashboard {
        id: string @unique
        name: string
        ownerId: string
        layout: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Report {
        id: string @unique
        dashboardId: string
        name: string
        schedule: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Connection {
        id: string @unique
        name: string
        type: string
        host: string
        active: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Metric {
        id: string @unique
        datasetId: string
        name: string
        expression: string
        unit: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
