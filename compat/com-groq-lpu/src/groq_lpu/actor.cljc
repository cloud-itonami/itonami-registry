      (-transact port sets)
      (-pull port id))))

(defn delete-interconnect-link
  "Delete a InterconnectLink."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

;; ── InferenceJob ────────────────────────────────────────────────────────────────
(defn create-inference-job
  "Create a InferenceJob."
  [port data]
  (require-fields data ["batchSize" "status"])
  (let [id (new-id "lpu_inf")
        e {:db/id id
           :groq_lpu.InferenceJob/id id
           :groq_lpu.InferenceJob/modelId (get data :modelId)
           :groq_lpu.InferenceJob/chipId (get data :chipId)
           :groq_lpu.InferenceJob/batchSize (as-long (get data :batchSize))
           :groq_lpu.InferenceJob/status (get data :status)
           :groq_lpu.InferenceJob/createdAt (now)
           :groq_lpu.InferenceJob/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-inference-jobs
  "List InferenceJob with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-inference-jobs port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :groq_lpu.InferenceJob/id))
         rows (apply-filters rows (:filter opts) [:groq_lpu.InferenceJob/modelId :groq_lpu.InferenceJob/chipId :groq_lpu.InferenceJob/batchSize :groq_lpu.InferenceJob/status])]
     (paginate rows opts))))

(defn get-inference-job
  "Retrieve a InferenceJob by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-inference-job port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec
         (and want (contains? want :modelId) (get rec :groq_lpu.InferenceJob/modelId))
         (assoc :modelId-obj (-pull port (get rec :groq_lpu.InferenceJob/modelId))))))))

(defn update-inference-job
  "Update a InferenceJob; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :modelId) (conj [:db/add id :groq_lpu.InferenceJob/modelId (get data :modelId)]))
                   (cond-> (contains? data :chipId) (conj [:db/add id :groq_lpu.InferenceJob/chipId (get data :chipId)]))
                   (cond-> (contains? data :batchSize) (conj [:db/add id :groq_lpu.InferenceJob/batchSize (as-long (get data :batchSize))]))
                   (cond-> (contains? data :status) (conj [:db/add id :groq_lpu.InferenceJob/status (get data :status)]))
                   (conj [:db/add id :groq_lpu.InferenceJob/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-inference-job
  "Delete a InferenceJob."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

