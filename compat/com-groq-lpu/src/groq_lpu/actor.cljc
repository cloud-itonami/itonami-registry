   "tensorstreams" {:create create-tensor-stream :list list-tensor-streams :get get-tensor-stream :update update-tensor-stream :delete delete-tensor-stream}
   "scheduleslots" {:create create-schedule-slot :list list-schedule-slots :get get-schedule-slot :update update-schedule-slot :delete delete-schedule-slot}
   "models" {:create create-model :list list-models :get get-model :update update-model :delete delete-model}
