// groq_lpu clean-room schema -> Datomic EAVT mapping
// LPU deterministic language-processing inference.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace groq_lpu {

    entity LpuChip {
        id: string @unique
        name: string
        generation: string
        sramMb: integer
        tflops: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity TensorStream {
        id: string @unique
        chipId: string
        direction: string
        widthBytes: integer
        throughputGbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity ScheduleSlot {
        id: string @unique
        chipId: string
        cycle: integer
        instruction: string
        unit: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Model {
        id: string @unique
        name: string
        parameters: integer
        quantization: string
        tokensPerSec: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity InterconnectLink {
        id: string @unique
        chipId: string
        peerId: string
        bandwidthGbps: float
        topology: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity InferenceJob {
        id: string @unique
        modelId: string
        chipId: string
        batchSize: integer
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
