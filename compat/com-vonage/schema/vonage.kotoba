// Vonage clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace vonage {

    entity Call {
        id: string @unique
        fromNumber: string
        toNumber: string
        status: string
        direction: string
        duration: integer
        price: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Message {
        id: string @unique
        messageId: string
        toNumber: string
        fromNumber: string
        status: string
        messageType: string
        channel: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Number {
        id: string @unique
        msisdn: string
        country: string
        type: string
        cost: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Verification {
        id: string @unique
        requestId: string
        number: string
        status: string
        codeLength: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Application {
        id: string @unique
        name: string
        type: string
        answerUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

}
