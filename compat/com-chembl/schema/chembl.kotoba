// Chembl clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace chembl {

    entity Molecule {
        id: string @unique
        chemblId: string
        prefName: string
        moleculeType: string
        blackBoxWarning: integer
        therapeuticFlag: boolean
        firstApproval: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Assay {
        id: string @unique
        chemblId: string
        assayType: string
        description: string
        confidenceScore: integer
        targetChemblId: string
        documentChemblId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Target {
        id: string @unique
        chemblId: string
        prefName: string
        targetType: string
        organism: string
        speciesGroupFlag: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Activity {
        id: string @unique
        activityId: integer
        moleculeChemblId: string
        assayChemblId: string
        standardValue: string
        standardType: string
        documentYear: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Document {
        id: string @unique
        chemblId: string
        title: string
        docType: string
        year: integer
        pubmedId: integer
        doi: string
        createdAt: datetime
        updatedAt: datetime
    }

}
