  "components": {
    "schemas": {
      "Molecule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "chemblId": {
            "type": "string"
          },
          "prefName": {
            "type": "string"
          },
          "moleculeType": {
            "type": "string",
            "enum": [
              "Small molecule",
              "Protein",
              "Antibody",
              "Oligonucleotide",
              "Oligosaccharide",
              "Enzyme",
              "Cell",
              "Unknown"
            ]
          },
          "blackBoxWarning": {
            "type": "integer"
          },
          "therapeuticFlag": {
            "type": "boolean"
          },
          "firstApproval": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MoleculeCreate": {
        "type": "object",
        "properties": {
          "chemblId": {
            "type": "string"
          },
          "prefName": {
            "type": "string"
          },
          "moleculeType": {
            "type": "string",
            "enum": [
              "Small molecule",
              "Protein",
              "Antibody",
              "Oligonucleotide",
              "Oligosaccharide",
              "Enzyme",
              "Cell",
              "Unknown"
            ]
          },
          "blackBoxWarning": {
            "type": "integer"
          },
          "therapeuticFlag": {
            "type": "boolean"
          },
          "firstApproval": {
            "type": "integer"
          }
        },
        "required": [
          "prefName",
          "moleculeType"
        ]
      },
      "Assay": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "chemblId": {
            "type": "string"
          },
          "assayType": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "confidenceScore": {
            "type": "integer"
          },
          "targetChemblId": {
            "type": "string"
          },
          "documentChemblId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AssayCreate": {
        "type": "object",
        "properties": {
          "chemblId": {
            "type": "string"
          },
          "assayType": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "confidenceScore": {
            "type": "integer"
          },
          "targetChemblId": {
            "type": "string"
          },
          "documentChemblId": {
            "type": "string"
          }
        },
        "required": [
          "assayType",
          "description"
        ]
      },
      "Target": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "chemblId": {
            "type": "string"
          },
          "prefName": {
            "type": "string"
          },
          "targetType": {
            "type": "string",
            "enum": [
              "CELL-LINE",
              "CHIMERIC PROTEIN",
              "MACROMOLECULE",
              "NUCLEIC-ACID",
              "OLIGOSACCHARIDE",
              "ORGANISM",
              "PROTEIN COMPLEX",
              "PROTEIN COMPLEX GROUP",
              "PROTEIN FAMILY",
              "PROTEIN-PROTEIN INTERACTION",
              "SELECTIVITY GROUP",
              "SINGLE PROTEIN",
              "TISSUE"
            ]
          },
          "organism": {
            "type": "string"
          },
          "speciesGroupFlag": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TargetCreate": {
        "type": "object",
        "properties": {
          "chemblId": {
            "type": "string"
          },
