// Twitch clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace twitch {

    entity User {
        id: string @unique
        userLogin: string
        userName: string
        broadcasterType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Channel {
        id: string @unique
        broadcasterLogin: string
        broadcasterName: string
        broadcasterLanguage: string
        gameId: string
        gameName: string
        title: string
        delay: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Stream {
        id: string @unique
        userId: string
        userName: string
        gameId: string
        gameName: string
        type: string
        viewerCount: integer
        title: string
        language: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Video {
        id: string @unique
        userId: string
        title: string
        description: string
        type: string
        viewable: string
        viewCount: integer
        duration: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Clip {
        id: string @unique
        broadcasterId: string
        creatorId: string
        gameId: string
        title: string
        viewCount: integer
        duration: float
        isFeatured: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Game {
        id: string @unique
        name: string
        boxArtUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

}
