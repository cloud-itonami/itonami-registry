namespace sendbird {

    entity User {
        id: string @unique
        userId: string
        nickname: string
        profileUrl: string
        accessToken: string
        isActive: boolean
        role: string
        createdAt: integer
        lastSeenAt: integer
        isOnline: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Message {
        id: string @unique
        messageId: integer
        type: string
        customType: string
        message: string
        channelUrl: string
        createdAt: integer
        updatedAt: integer
        isRemoved: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity GroupChannel {
        id: string @unique
        channelUrl: string
        name: string
        memberCount: integer
        isDistinct: boolean
        createdAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity OpenChannel {
        id: string @unique
        channelUrl: string
        name: string
        participantCount: integer
        createdAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
