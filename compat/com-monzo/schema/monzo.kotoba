namespace monzo {

    entity Account {
        id: string @unique
        id: string
        description: string
        type: string
        created: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Balance {
        id: string @unique
        balance: integer
        totalBalance: integer
        currency: string
        spendToday: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Transaction {
        id: string @unique
        id: string
        amount: integer
        currency: string
        description: string
        category: string
        declineReason: string
        isLoad: boolean
        merchant: string
        created: datetime
        settled: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Pot {
        id: string @unique
        id: string
        name: string
        balance: integer
        currency: string
        deleted: boolean
        created: datetime
        updated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Attachment {
        id: string @unique
        id: string
        userId: string
        externalId: string
        fileUrl: string
        fileType: string
        created: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
