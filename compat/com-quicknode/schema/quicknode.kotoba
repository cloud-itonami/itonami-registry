// Quicknode clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace quicknode {

    entity Block {
        id: string @unique
        number: integer
        hash: string
        chain: string
        minedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Transaction {
        id: string @unique
        hash: string
        fromAddr: string
        toAddr: string
        value: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Contract {
        id: string @unique
        address: string
        chain: string
        abiRef: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Account {
        id: string @unique
        address: string
        chain: string
        balance: float
        nonce: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Event {
        id: string @unique
        contractAddr: string
        name: string
        blockNumber: integer
        dataRef: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Token {
        id: string @unique
        contractAddr: string
        symbol: string
        decimals: integer
        standard: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
