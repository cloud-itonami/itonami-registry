// Pubmed clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).
// L5 (Verified 2026-06-09): remodeled from generic template to faithful PubMed
// resources reconciled against the NCBI E-utilities help (NBK25499) and the
// PubMed DTD pubmed_190101.dtd. Field names trace PubmedArticle element names.

namespace pubmed {

    // PubmedArticle -> MedlineCitation/PMID + Article(+Journal embed).
    // DTD: Article (Journal, ArticleTitle, (Pagination|ELocationID), Abstract?,
    //   AuthorList?, Language+, ..., PublicationTypeList, ...).
    entity Article {
        id: string @unique
        pmid: string
        title: string
        abstract: string
        journalTitle: string
        isoAbbreviation: string
        issn: string
        issnType: string
        volume: string
        issue: string
        pages: string
        publishedAt: datetime
        pubDateYear: int
        pubDateMonth: string
        pubDateDay: string
        medlineDate: string
        doi: string
        pmc: string
        pmcid: string
        language: string
        languages: json
        publicationTypes: json
        vernacularTitle: string
        createdAt: datetime
        updatedAt: datetime
    }

    // DTD: Author ((LastName, ForeName?, Initials?, Suffix?) | CollectiveName),
    //   Identifier* (Source CDATA, e.g. ORCID), AffiliationInfo* (Affiliation).
    entity Author {
        id: string @unique
        articleId: string
        lastName: string
        foreName: string
        initials: string
        suffix: string
        collectiveName: string
        affiliation: string
        orcid: string
        createdAt: datetime
        updatedAt: datetime
    }

    // DTD: MeshHeading (DescriptorName, QualifierName*).
    //   DescriptorName @MajorTopicYN (Y|N), @UI; QualifierName @MajorTopicYN, @UI.
    entity MeshHeading {
        id: string @unique
        articleId: string
        descriptorName: string
        descriptorUi: string
        majorTopic: bool
        qualifiers: json
        createdAt: datetime
        updatedAt: datetime
    }

    // DTD: Journal (ISSN?, JournalIssue, Title?, ISOAbbreviation?) +
    //   MedlineJournalInfo (Country?, MedlineTA, NlmUniqueID?, ISSNLinking?).
    entity Journal {
        id: string @unique
        issn: string
        issnType: string
        issnLinking: string
        title: string
        isoAbbreviation: string
        nlmUniqueId: string
        medlineTa: string
        country: string
        createdAt: datetime
        updatedAt: datetime
    }

    // E-utilities query record (NBK25499): esearch/efetch params + history server.
    // retmode enum {xml,json,text}; esearch rettype {uilist,count};
    // efetch rettype {abstract,medline,...}; datetype {mdat,pdat,edat}.
    entity EutilsQuery {
        id: string @unique
        db: string
        term: string
        retmode: string
        rettype: string
        retstart: int
        retmax: int
        sort: string
        datetype: string
        reldate: int
        minDate: string
        maxDate: string
        usehistory: bool
        webEnv: string
        queryKey: int
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
