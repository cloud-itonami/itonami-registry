  "Create a OpticalEngine."
  [port data]
  (require-fields data ["name" "generation"])
  (let [id (new-id "cpo_opt")
        e {:db/id id
           :copackaged_optics.OpticalEngine/id id
           :copackaged_optics.OpticalEngine/name (get data :name)
           :copackaged_optics.OpticalEngine/generation (get data :generation)
           :copackaged_optics.OpticalEngine/lanes (as-long (get data :lanes))
           :copackaged_optics.OpticalEngine/aggregateTbps (as-double (get data :aggregateTbps))
           :copackaged_optics.OpticalEngine/createdAt (now)
           :copackaged_optics.OpticalEngine/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-optical-engines
  "List OpticalEngine with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-optical-engines port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :copackaged_optics.OpticalEngine/id))
         rows (apply-filters rows (:filter opts) [:copackaged_optics.OpticalEngine/name :copackaged_optics.OpticalEngine/generation :copackaged_optics.OpticalEngine/lanes :copackaged_optics.OpticalEngine/aggregateTbps])]
     (paginate rows opts))))

(defn get-optical-engine
  "Retrieve a OpticalEngine by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-optical-engine port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-optical-engine
  "Update a OpticalEngine; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :name) (conj [:db/add id :copackaged_optics.OpticalEngine/name (get data :name)]))
                   (cond-> (contains? data :generation) (conj [:db/add id :copackaged_optics.OpticalEngine/generation (get data :generation)]))
