;; collection → CRUD fns, keyed by the /v1/<collection> path segment
(def ^:private handlers
  {"opticalengines" {:create create-optical-engine :list list-optical-engines :get get-optical-engine :update update-optical-engine :delete delete-optical-engine}
   "electrooptictiles" {:create create-electro-optic-tile :list list-electro-optic-tiles :get get-electro-optic-tile :update update-electro-optic-tile :delete delete-electro-optic-tile}
   "fiberlinks" {:create create-fiber-link :list list-fiber-links :get get-fiber-link :update update-fiber-link :delete delete-fiber-link}
   "serdeslanes" {:create create-serdes-lane :list list-serdes-lanes :get get-serdes-lane :update update-serdes-lane :delete delete-serdes-lane}
   "opticalswitches" {:create create-optical-switch :list list-optical-switches :get get-optical-switch :update update-optical-switch :delete delete-optical-switch}
   "linkbudgets" {:create create-link-budget :list list-link-budgets :get get-link-budget :update update-link-budget :delete delete-link-budget}})

(defn- expand-opts [params]
  (when-let [x (:expand params)]
    {:expand (set (map keyword (str/split (str x) #",")))}))

(defn dispatch
  "Route an HTTP-ish request through `routes` to the CRUD fns.
   req: {:method (:get/:post/:patch/:delete) :path /v1/<coll>[/<id>] :params {} :body {}}.
   Returns {:status int :body any} — the runnable L4 service surface."
  [port {:keys [method path params body]}]
  (let [segs (->> (str/split (or path "") #"/") (remove str/blank?) vec)
        coll (get segs 1)
        id   (get segs 2)
        h    (get handlers coll)
        params (or params {})]
    (cond
      (nil? h) {:status 404 :body {:error "unknown collection"}}
      (and (= method :post) (nil? id)) {:status 201 :body ((:create h) port (or body params))}
      (and (= method :get) (nil? id)) {:status 200 :body ((:list h) port params)}
      (and (= method :get) id) (if-let [r ((:get h) port id (expand-opts params))]
                                 {:status 200 :body r} {:status 404 :body {:error "not found"}})
      (and (#{:patch :put} method) id) (if-let [r ((:update h) port id (or body params))]
                                         {:status 200 :body r} {:status 404 :body {:error "not found"}})
      (and (= method :delete) id) {:status 200 :body ((:delete h) port id)}
      :else {:status 405 :body {:error "method not allowed"}})))

