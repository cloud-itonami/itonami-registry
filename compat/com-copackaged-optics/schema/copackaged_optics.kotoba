// copackaged_optics clean-room schema -> Datomic EAVT mapping
// Co-packaged optics / 光電融合 optical interconnect.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace copackaged_optics {

    entity OpticalEngine {
        id: string @unique
        name: string
        generation: string
        lanes: integer
        aggregateTbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity ElectroOpticTile {
        id: string @unique
        engineId: string
        tileType: string
        channels: integer
        powerPjPerBit: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity FiberLink {
        id: string @unique
        engineId: string
        fiberType: string
        reachM: float
        dataRateGbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity SerdesLane {
        id: string @unique
        engineId: string
        index: integer
        modulation: string
        dataRateGbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity OpticalSwitch {
        id: string @unique
        engineId: string
        radix: integer
        technology: string
        insertionLossDb: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity LinkBudget {
        id: string @unique
        engineId: string
        txPowerDbm: float
        rxSensitivityDbm: float
        marginDb: float
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
