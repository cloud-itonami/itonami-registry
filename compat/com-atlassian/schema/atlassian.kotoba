// Atlassian clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace atlassian {

    entity Project {
        id: string @unique
        key: string
        name: string
        projectTypeKey: string
        style: string
        archived: boolean
        simplified: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity IssueType {
        id: string @unique
        name: string
        description: string
        subtask: boolean
        hierarchyLevel: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Status {
        id: string @unique
        name: string
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity StatusCategory {
        id: string @unique
        key: string
        name: string
        colorName: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        accountId: string
        accountType: string
        displayName: string
        emailAddress: string
        active: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Comment {
        id: string @unique
        body: string
        created: datetime
        updated: datetime
        jsdPublic: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
