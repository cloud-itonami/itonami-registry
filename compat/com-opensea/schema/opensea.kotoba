        imageUrl: string
        safelistStatus: string
        isDisabled: boolean
        isNsfw: boolean
        totalSupply: integer
        createdDate: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Listing {
        id: string @unique
        orderHash: string
        chain: string
        protocolAddress: string
        remainingQuantity: integer
        orderCreatedAt: integer
        type: string
        status: string
