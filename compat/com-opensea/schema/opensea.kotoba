        description: string
        imageUrl: string
        openseaUrl: string
        isDisabled: boolean
        isNsfw: boolean
        updatedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Collection {
        id: string @unique
        collection: string
        name: string
