// Jenkins clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace jenkins {

    entity Build {
        id: string @unique
        number: integer
        result: string
        building: boolean
        duration: integer
        timestamp: integer
        displayName: string
        description: string
        id: string
        queueId: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Job {
        id: string @unique
        name: string
        displayName: string
        description: string
        color: string
        nextBuildNumber: integer
        url: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity QueueItem {
        id: string @unique
        id: integer
        inQueueSince: integer
        why: string
        blocked: boolean
        buildable: boolean
        stuck: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Computer {
        id: string @unique
        displayName: string
        name: string
        url: string
        offline: boolean
        offlineCauseReason: string
        numExecutors: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity View {
        id: string @unique
        name: string
        url: string
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

}
