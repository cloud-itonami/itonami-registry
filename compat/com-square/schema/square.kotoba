// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace square {

    entity Payment {
        id: string @unique
        orderId: string
        customerId: string
        amount: integer
        currency: string
        status: string
        sourceType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Order {
        id: string @unique
        locationId: string
        customerId: string
        state: string
        totalAmount: integer
        currency: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Customer {
        id: string @unique
        givenName: string
        familyName: string
        emailAddress: string
        phoneNumber: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Refund {
        id: string @unique
        paymentId: string
        amount: integer
        currency: string
        status: string
        reason: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity CatalogObject {
        id: string @unique
        type: string
        name: string
        version: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Invoice {
        id: string @unique
        orderId: string
        status: string
        invoiceNumber: string
        createdAt: datetime
        updatedAt: datetime
    }

}
