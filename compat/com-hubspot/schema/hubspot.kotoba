// Hubspot clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace hubspot {

    entity Contact {
        id: string @unique
        email: string
        firstname: string
        lastname: string
        company: string
        phone: string
        website: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Company {
        id: string @unique
        name: string
        domain: string
        industry: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Deal {
        id: string @unique
        dealname: string
        dealstage: string
        amount: float
        pipeline: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Ticket {
        id: string @unique
        subject: string
        hsTicketPriority: string
        hsPipelineStage: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity LineItem {
        id: string @unique
        name: string
        quantity: integer
        price: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Pipeline {
        id: string @unique
        label: string
        displayOrder: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
