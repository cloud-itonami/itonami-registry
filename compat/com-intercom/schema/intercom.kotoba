namespace intercom {

    entity Contact {
        id: string @unique
        email: string
        phone: string
        name: string
        role: string
        createdAt: integer
        signedUpAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Conversation {
        id: string @unique
        state: string
        priority: string
        open: boolean
        read: boolean
        adminAssigneeId: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Company {
        id: string @unique
        name: string
        industry: string
        monthlySpend: integer
        size: integer
        companyId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Admin {
        id: string @unique
        name: string
        email: string
        awayModeEnabled: boolean
        hasInboxSeat: boolean
        jobTitle: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Article {
        id: string @unique
        title: string
        body: string
        state: string
        authorId: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Tag {
        id: string @unique
        name: string
        appliedAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
