        path: string
        retries: integer
        enabled: boolean
        connectTimeout: integer
        createdAt: integer
        updatedAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Route {
        id: string @unique
        id: string
        name: string
        service: string
        stripPath: boolean
        preserveHost: boolean
        priority: integer
        pathHandling: string
        httpsRedirectStatusCode: integer
        createdAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Consumer {
        id: string @unique
        id: string
        username: string
        customId: string
        createdAt: integer
        updatedAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Plugin {
        id: string @unique
        id: string
        name: string
        instanceName: string
        service: string
        route: string
        consumer: string
        enabled: boolean
        createdAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Upstream {
        id: string @unique
        id: string
        name: string
        algorithm: string
        hashOn: string
        hashFallback: string
        hashOnHeader: string
        createdAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Target {
        id: string @unique
        id: string
        upstream: string
        target: string
        weight: integer
        createdAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
