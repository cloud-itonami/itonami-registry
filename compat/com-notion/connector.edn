{:schema "kotoba.connector.repository.v1",
 :connector/docs-url "https://developers.notion.com/reference/intro",
 :connector/origin-domain "notion.com",
 :connector/base-scopes [],
 :connector/id "com.notion",
 :connector/var "provider",
 :connector/scopes [],
 :authority
 "90-docs/adr/2608097000-connector-plane-one-repo-per-connector.edn",
 :connector/namespace "notion.connector",
 :connector/auth-kind :oauth2,
 :connector/auth-pkce? false,
 :connector/summary
 "Search a workspace, read pages and databases, create a page.",
 :connector/name "Notion",
 :connector/client-id-env "NOTION_CLIENT_ID",
 :connector/tools
 [{:connector/name "notion_create_page",
   :connector/effect :write,
   :connector/scopes [],
   :connector/description
   "Create a page under a parent page or database."}
  {:connector/name "notion_get_block_children",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description
   "The blocks inside a page or block — this is where the text lives."}
  {:connector/name "notion_get_page",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description
   "One page's properties. Block content is a separate call — see notion_get_block_children."}
  {:connector/name "notion_query_database",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description
   "Rows of a database, with optional filter and sort."}
  {:connector/name "notion_search",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description
   "Search pages and databases the integration has been shared with."}]}
