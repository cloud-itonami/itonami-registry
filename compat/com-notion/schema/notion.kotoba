namespace notion {

    entity Page {
        id: string @unique
        object: string
        createdTime: datetime
        lastEditedTime: datetime
        inTrash: boolean
        url: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Database {
        id: string @unique
        object: string
        title: string
        description: string
        isInline: boolean
        url: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Block {
        id: string @unique
        object: string
        type: string
        hasChildren: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        object: string
        name: string
        type: string
        avatarUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Comment {
        id: string @unique
        discussionId: string
        createdTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
