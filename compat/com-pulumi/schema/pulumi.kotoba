        version: integer
        resourceCount: integer
        startTime: integer
        endTime: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Stack {
        id: string @unique
        stackName: string
        orgName: string
        projectName: string
        id: string
        lastUpdate: integer
        resourceCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Policy {
        id: string @unique
        name: string
        displayName: string
        description: string
        enforcementLevel: string
        severity: string
        message: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Deployment {
        id: string @unique
        id: string
        status: string
        projectName: string
        stackName: string
        paused: boolean
        created: datetime
        modified: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Organization {
        id: string @unique
        name: string
        role: string
        createdAt: datetime
        updatedAt: datetime
    }

}
