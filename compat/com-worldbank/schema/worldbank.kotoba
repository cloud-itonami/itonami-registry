namespace worldbank {

    entity Country {
        id: string @unique
        id: string
        iso2Code: string
        name: string
        capitalCity: string
        incomeLevelId: string
        lendingTypeId: string
        regionId: string
        longitude: string
        latitude: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Indicator {
        id: string @unique
        id: string
        name: string
        unit: string
        sourceId: string
        sourceNote: string
        sourceOrganization: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Source {
        id: string @unique
        id: string
        name: string
        code: string
        lastUpdated: string
        dataAvailability: boolean
        concepts: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity IncomeLevel {
        id: string @unique
        id: string
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity LendingType {
        id: string @unique
        id: string
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Topic {
        id: string @unique
        id: string
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

}
