namespace eidas {

    entity AuthenticationAssertion {
        id: string @unique
        id: string
        levelOfAssurance: string
        issueInstant: datetime
        sessionIndex: string
        issuer: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity EidasAttribute {
        id: string @unique
        name: string
        friendlyName: string
        nameFormat: string
        value: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity TrustService {
        id: string @unique
        id: string
        serviceProvider: string
        serviceName: string
        serviceType: string
        status: string
        statusStartingTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Subject {
        id: string @unique
        nameID: string
        format: string
        spNameQualifier: string
        createdAt: datetime
        updatedAt: datetime
    }

}
