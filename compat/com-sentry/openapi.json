  "components": {
    "schemas": {
      "Issue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "shortId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ignored",
              "resolved",
              "unresolved"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "fatal",
              "error",
