// Sentry clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace sentry {

    entity Issue {
        id: string @unique
        shortId: string
        title: string
        status: string
        level: string
        priority: string
        count: integer
        userCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Event {
        id: string @unique
        eventID: string
        groupID: string
        projectID: string
        title: string
        message: string
        level: string
        platform: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Project {
        id: string @unique
        slug: string
        name: string
        platform: string
        isBookmarked: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Organization {
        id: string @unique
        slug: string
        name: string
        hasAuthProvider: boolean
        require2FA: boolean
        isEarlyAdopter: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Team {
        id: string @unique
        slug: string
        name: string
        memberCount: integer
        hasAccess: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Release {
        id: string @unique
        version: string
        status: string
        commitCount: integer
        deployCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
