  "Delete a SpeedBin."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

;; ── JedecSpec ────────────────────────────────────────────────────────────────
(defn create-jedec-spec
  "Create a JedecSpec."
  [port data]
  (require-fields data ["standard" "revision"])
  (let [id (new-id "dram_jed")
        e {:db/id id
           :dram_design.JedecSpec/id id
           :dram_design.JedecSpec/deviceId (get data :deviceId)
           :dram_design.JedecSpec/standard (get data :standard)
           :dram_design.JedecSpec/revision (get data :revision)
           :dram_design.JedecSpec/compliant (as-bool (get data :compliant))
           :dram_design.JedecSpec/createdAt (now)
           :dram_design.JedecSpec/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-jedec-specs
  "List JedecSpec with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-jedec-specs port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :dram_design.JedecSpec/id))
         rows (apply-filters rows (:filter opts) [:dram_design.JedecSpec/deviceId :dram_design.JedecSpec/standard :dram_design.JedecSpec/revision :dram_design.JedecSpec/compliant])]
     (paginate rows opts))))

(defn get-jedec-spec
  "Retrieve a JedecSpec by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-jedec-spec port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-jedec-spec
  "Update a JedecSpec; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :deviceId) (conj [:db/add id :dram_design.JedecSpec/deviceId (get data :deviceId)]))
                   (cond-> (contains? data :standard) (conj [:db/add id :dram_design.JedecSpec/standard (get data :standard)]))
                   (cond-> (contains? data :revision) (conj [:db/add id :dram_design.JedecSpec/revision (get data :revision)]))
                   (cond-> (contains? data :compliant) (conj [:db/add id :dram_design.JedecSpec/compliant (as-bool (get data :compliant))]))
                   (conj [:db/add id :dram_design.JedecSpec/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-jedec-spec
  "Delete a JedecSpec."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

