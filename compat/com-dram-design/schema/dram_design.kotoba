// dram_design clean-room schema -> Datomic EAVT mapping
// DRAM cell / array design (DDR5 / LPDDR).
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace dram_design {

    entity DramDevice {
        id: string @unique
        partNumber: string
        generation: string
        densityGb: integer
        dataRateMtps: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity CellArray {
        id: string @unique
        deviceId: string
        rows: integer
        columns: integer
        capacitorType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Bank {
        id: string @unique
        deviceId: string
        bankGroup: integer
        index: integer
        pageSizeKb: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity TimingProfile {
        id: string @unique
        deviceId: string
        casLatency: integer
        tRCD: integer
        tRP: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity SpeedBin {
        id: string @unique
        deviceId: string
        grade: string
        voltage: float
        dataRateMtps: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity JedecSpec {
        id: string @unique
        deviceId: string
        standard: string
        revision: string
        compliant: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
