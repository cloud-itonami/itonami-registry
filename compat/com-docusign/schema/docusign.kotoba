// Docusign clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace docusign {

    entity Envelope {
        id: string @unique
        emailSubject: string
        status: string
        sentDateTime: datetime
        completedDateTime: datetime
        envelopeId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Signer {
        id: string @unique
        email: string
        firstName: string
        lastName: string
        status: string
        signedDateTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Document {
        id: string @unique
        documentId: string
        name: string
        order: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity SignHereTab {
        id: string @unique
        tabId: string
        pageNumber: string
        xPosition: string
        yPosition: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity EnvelopeTemplate {
        id: string @unique
        templateId: string
        name: string
        status: string
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

}
