        flowLabel: integer
        payloadLength: integer
        nextHeader: integer
        hopLimit: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Icmpv6Message {
        id: string @unique
        type: integer
        code: integer
        checksum: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity DestinationUnreachable {
        id: string @unique
        type: integer
        code: integer
        checksum: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity TimeExceeded {
        id: string @unique
        type: integer
