// Twilio clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace twilio {

    entity Message {
        id: string @unique
        fromNumber: string
        toNumber: string
        body: string
        status: string
        direction: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Call {
        id: string @unique
        fromNumber: string
        toNumber: string
        status: string
        durationSec: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity PhoneNumber {
        id: string @unique
        e164: string
        capabilities: string
        friendlyName: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Verification {
        id: string @unique
        toNumber: string
        channel: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Recording {
        id: string @unique
        callSid: string
        durationSec: integer
        contentRef: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Conference {
        id: string @unique
        friendlyName: string
        status: string
        participantCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
