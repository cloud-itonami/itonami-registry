namespace ros2_nav {

    entity GoalStatus {
        id: string @unique
        goalId: string
        stamp: datetime
        status: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity NavSatFix {
        id: string @unique
        latitude: float
        longitude: float
        altitude: float
        status: integer
        service: integer
        positionCovarianceType: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity BatteryState {
        id: string @unique
        voltage: float
        temperature: float
        current: float
        charge: float
        percentage: float
        powerSupplyStatus: integer
        powerSupplyHealth: integer
        powerSupplyTechnology: integer
        present: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Odometry {
        id: string @unique
        childFrameId: string
        poseX: float
        poseY: float
        poseZ: float
        twistLinearX: float
        twistLinearY: float
        twistLinearZ: float
        twistAngularX: float
        twistAngularY: float
        twistAngularZ: float
        createdAt: datetime
        updatedAt: datetime
    }

}
