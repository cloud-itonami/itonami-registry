                   (cond-> (contains? data :retimer) (conj [:db/add id :ucie_chiplet.ProtocolLayer/retimer (as-bool (get data :retimer))]))
                   (conj [:db/add id :ucie_chiplet.ProtocolLayer/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-protocol-layer
  "Delete a ProtocolLayer."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

;; ── Package ────────────────────────────────────────────────────────────────
(defn create-package
  "Create a Package."
  [port data]
  (require-fields data ["name" "substrate"])
  (let [id (new-id "ucie_pac")
        e {:db/id id
           :ucie_chiplet.Package/id id
           :ucie_chiplet.Package/name (get data :name)
           :ucie_chiplet.Package/substrate (get data :substrate)
           :ucie_chiplet.Package/chipletCount (as-long (get data :chipletCount))
           :ucie_chiplet.Package/interposer (get data :interposer)
           :ucie_chiplet.Package/createdAt (now)
           :ucie_chiplet.Package/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-packages
  "List Package with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-packages port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :ucie_chiplet.Package/id))
         rows (apply-filters rows (:filter opts) [:ucie_chiplet.Package/name :ucie_chiplet.Package/substrate :ucie_chiplet.Package/chipletCount :ucie_chiplet.Package/interposer])]
     (paginate rows opts))))

(defn get-package
  "Retrieve a Package by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-package port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-package
  "Update a Package; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :name) (conj [:db/add id :ucie_chiplet.Package/name (get data :name)]))
                   (cond-> (contains? data :substrate) (conj [:db/add id :ucie_chiplet.Package/substrate (get data :substrate)]))
                   (cond-> (contains? data :chipletCount) (conj [:db/add id :ucie_chiplet.Package/chipletCount (as-long (get data :chipletCount))]))
                   (cond-> (contains? data :interposer) (conj [:db/add id :ucie_chiplet.Package/interposer (get data :interposer)]))
                   (conj [:db/add id :ucie_chiplet.Package/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-package
  "Delete a Package."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

