// ucie_chiplet clean-room schema -> Datomic EAVT mapping
// UCIe chiplet die-to-die interconnect / advanced packaging.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace ucie_chiplet {

    entity Chiplet {
        id: string @unique
        name: string
        function: string
        processNode: string
        areaMm2: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity UcieLink {
        id: string @unique
        chipletId: string
        mode: string
        lanes: integer
        dataRateGtps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity BumpArray {
        id: string @unique
        chipletId: string
        pitchUm: float
        count: integer
        bumpType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Sideband {
        id: string @unique
        linkId: string
        function: string
        frequencyMhz: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity ProtocolLayer {
        id: string @unique
        linkId: string
        protocol: string
        flitFormat: string
        retimer: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Package {
        id: string @unique
        name: string
        substrate: string
        chipletCount: integer
        interposer: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
