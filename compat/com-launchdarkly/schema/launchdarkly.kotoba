// Launchdarkly clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace launchdarkly {

    entity FeatureFlag {
        id: string @unique
        key: string
        name: string
        kind: string
        description: string
        temporary: boolean
        archived: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Project {
        id: string @unique
        id: string
        key: string
        name: string
        includeInSnippetByDefault: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Environment {
        id: string @unique
        id: string
        key: string
        name: string
        apiKey: string
        mobileKey: string
        color: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Segment {
        id: string @unique
        key: string
        name: string
        environmentKey: string
        description: string
        deleted: boolean
        creationDate: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Member {
        id: string @unique
        id: string
        email: string
        firstName: string
        lastName: string
        role: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Webhook {
        id: string @unique
        id: string
        name: string
        url: string
        on: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
