// Arxiv_api clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).
// L5 (Verified): reconciled against the official arXiv API user manual
// (https://info.arxiv.org/help/api/user-manual.html) on 2026-06-09.
// arXiv returns Atom feeds; each <entry> is a paper, plus feed-level
// opensearch metadata and the GET query (search_query) interface.

namespace arxiv_api {

    // An Atom <entry>: one arXiv paper/article version.
    entity Entry {
        id: string @unique
        arxivId: string
        title: string
        summary: string
        primaryCategory: string
        doi: string
        journalRef: string
        comment: string
        published: datetime
        updated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    // <author> child of an entry; <name> + optional <arxiv:affiliation>.
    entity Author {
        id: string @unique
        entryId: string
        name: string
        affiliation: string
        createdAt: datetime
        updatedAt: datetime
    }

    // <category> classification on an entry (term + scheme attributes).
    entity Category {
        id: string @unique
        entryId: string
        term: string
        scheme: string
        createdAt: datetime
        updatedAt: datetime
    }

    // <link> on an entry: abstract (alternate) / pdf / doi (related).
    entity Link {
        id: string @unique
        entryId: string
        href: string
        rel: string
        title: string
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    // The GET query interface (search_query / id_list / paging / sort).
    entity SearchQuery {
        id: string @unique
        searchQuery: string
        idList: string
        start: integer
        maxResults: integer
        sortBy: string
        sortOrder: string
        createdAt: datetime
        updatedAt: datetime
    }

    // Feed-level opensearch result metadata.
    entity Feed {
        id: string @unique
        totalResults: integer
        startIndex: integer
        itemsPerPage: integer
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
