// hbm_memory clean-room schema -> Datomic EAVT mapping
// HBM stack design / 3D TSV memory manufacture.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace hbm_memory {

    entity MemoryStack {
        id: string @unique
        partNumber: string
        generation: string
        heightDie: integer
        capacityGb: integer
        bandwidthGbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity DramDie {
        id: string @unique
        stackId: string
        processNode: string
        capacityGb: integer
        knownGoodDie: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity ThroughSiliconVia {
        id: string @unique
        stackId: string
        count: integer
        pitchUm: float
        aspectRatio: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity MemoryChannel {
        id: string @unique
        stackId: string
        width: integer
        pseudoChannels: integer
        dataRateGbps: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity RefreshPolicy {
        id: string @unique
        stackId: string
        mode: string
        intervalNs: float
        temperatureC: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity TestBin {
        id: string @unique
        stackId: string
        binCode: string
        yield: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
