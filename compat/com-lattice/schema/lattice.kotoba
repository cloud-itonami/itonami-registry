// Lattice clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace lattice {

    entity Employee {
        id: string @unique
        firstName: string
        lastName: string
        email: string
        title: string
        department: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Candidate {
        id: string @unique
        firstName: string
        lastName: string
        email: string
        stage: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity JobReq {
        id: string @unique
        title: string
        department: string
        status: string
        openings: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity PayrollRun {
        id: string @unique
        period: string
        grossTotal: float
        currency: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity TimeOff {
        id: string @unique
        employeeId: string
        type: string
        start: datetime
        days: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Review {
        id: string @unique
        employeeId: string
        cycle: string
        rating: float
        reviewerId: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
