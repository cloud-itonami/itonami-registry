        likes: integer
        private: boolean
        gated: string
        pipelineTag: string
        libraryName: string
        sha: string
        inference: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity DatasetInfo {
        id: string @unique
        author: string
        downloads: integer
        likes: integer
        private: boolean
        gated: string
        sha: string
        description: string
        mainSize: integer
        citation: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity SpaceInfo {
        id: string @unique
        author: string
        sha: string
        private: boolean
        sdk: string
        likes: integer
        host: string
        subdomain: string
        gated: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity TransformersInfo {
        id: string @unique
        autoModel: string
        customClass: string
        pipelineTag: string
        processor: string
        createdAt: datetime
        updatedAt: datetime
    }

}
