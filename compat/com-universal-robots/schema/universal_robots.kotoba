// Universal_robots clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace universal_robots {

    entity RtdeRobotState {
        id: string @unique
        timestamp: float
        robot_mode: integer
        robot_status_bits: integer
        safety_mode: integer
        safety_status_bits: integer
        actual_main_voltage: float
        actual_robot_voltage: float
        actual_robot_current: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity RtdeExecutionState {
        id: string @unique
        runtime_state: integer
        actual_execution_time: float
        speed_scaling: float
        target_speed_fraction: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity RtdeToolState {
        id: string @unique
        tool_mode: integer
        tool_output_voltage: integer
        tool_output_current: float
        tool_temperature: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity DashboardRobotState {
        id: string @unique
        robotmode: string
        safetystatus: string
        running: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity DashboardProgram {
        id: string @unique
        programName: string
        state: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity DashboardInstallation {
        id: string @unique
        installationName: string
        createdAt: datetime
        updatedAt: datetime
    }

}
