;; Row 20, final spelling: `nth` is not resolvable on this receiver
;; (g20h-vector-of-maps-nth-get.kotoba), so the constant is read with first/get.
;; The i64-element control g20i-vector-of-i64-control.kotoba passes, so anything
;; refused here is the MAP element and not the vector constant.
(ns g20j (:export [probe]))
(def specs [{:a 1} {:a 2}])
(defn probe [] :i64 (get (first specs) :a))
