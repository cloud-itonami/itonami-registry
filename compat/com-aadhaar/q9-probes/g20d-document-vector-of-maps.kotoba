;; Row 20 on the :document carrier, which is the language's heterogeneous-data
;; carrier. `(document ...)` is the sugar guest-grammar names as "exactly one
;; inert closed EDN-shaped tree".
(ns g20d (:export [probe]))
(defn specs [] :document
  (document [{:entity "ReserveData" :plural "reservedatas"}
             {:entity "EModeCategory" :plural "emodecategories"}]))
(defn probe [] :i64 (document-vector-count (specs)))
