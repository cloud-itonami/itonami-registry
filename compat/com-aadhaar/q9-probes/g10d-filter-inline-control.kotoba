;; Discriminating control for g10a2: the identical shape with `filter`, the head
;; that IS an admitted HOF. If this passes and g10a2 refuses, the refusal is
;; about `remove` and not about the inline fn.
(ns g10d (:export [probe]))
(def xs [1 2 3])
(defn probe [] :i64 (count (filter (fn [a :i64] :bool (> a 1)) xs)))
