;; Row 16, in Kotoba's vocabulary. There is no widening head to spell, because
;; an integer already HAS type :i64; the coercion that exists is float -> int.
(ns g16c (:export [probe]))
(defn widen [x :i64] :i64 x)
(defn from-float [x :f64] :i64 (f64-to-i64-truncating x))
(defn probe [] :i64 (+ (widen 3) (from-float (i64-to-f64-rounded 4))))
