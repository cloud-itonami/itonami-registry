;; Row 20, isolating the refusal. g20's message was about the VALUE type of the
;; keyword-keyed literal ("carries i64 values; the value at key :entity is
;; :string"), not about a vector of maps. Same shape, i64 values.
(ns g20b (:export [probe]))
(def specs [{:a 1 :b 2} {:a 3 :b 4}])
(defn probe [] :i64 (count specs))
