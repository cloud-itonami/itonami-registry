;; What the two declared capability imports actually answer under
;; tools/kexe_loader.c, and what happens when the grant is withdrawn.
;;
;; The aave sibling's component header says the granted `clock/now` "answers 1".
;; That is true only at seed 0. MEASURED here over five seeds, amu 6ffc1d71,
;; KEXE_FUEL=100000000:
;;
;;   grant 7,23:  c(0)=1  c(1)=2  c(2)=3  c(5)=6  c(100)=101
;;                e(0)=1  e(1)=2  e(2)=3  e(5)=6  e(100)=101
;;   grant  - :   c(1) -> KEXE_TRAP {:kind :signal :signal :SIGTRAP}, exit 120
;;                e(1) -> KEXE_TRAP {:kind :signal :signal :SIGTRAP}, exit 120
;;
;; Both directions matter. Without the withdrawn-grant run, a stub that simply
;; ignored the policy would look identical to a capability that is really being
;; granted. The trap is what discriminates.
;;
;; Consequence for the component: `now` and `rand-hex16` are exercised at a stub
;; instant, so oracle-clock / oracle-entropy are determinism checks on the
;; artifact and NOT parity checks against aadhaar.main, whose `now` reads a real
;; clock and whose `rand-hex16` reads a real UUID.
(ns g24-capability-stub
  (:capabilities #{:clock/now :entropy/draw})
  (:export [c e]))

(defn c [seed :i64] :i64 (clock/now seed))
(defn e [seed :i64] :i64 (entropy/draw seed))
