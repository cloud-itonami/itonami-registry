;; Row 13, with the option constructor frontend.cljc's `generic-option-operations`
;; actually names (option-some-of), rather than the guessed `option-some`.
(ns g13b (:export [probe]))
(defn twice [a :i64] :i64 (* a 2))
(defn probe [] :i64
  (option-value-of [:option :i64] (some-> (option-some-of [:option :i64] 21) twice) 0))
