;; Row 12, in Kotoba's vocabulary. `empty?` refuses on a pair-chain receiver
;; ("equality operands must have the same value type", g12b1-empty.kotoba), so
;; the emptiness half of `seq` is spelled with count, and the seq-view half is
;; first/rest, which both pass (g12b2, g12b3).
(ns g12b4 (:export [probe]))
(def xs [1 2 3])
(defn probe [] :i64 (if (= (count xs) 0) 0 (+ (first xs) (count (rest xs)))))
