;; Row 20, in Kotoba's vocabulary: the canonical [:map K V] the g20 refusal named,
;; collected into a vector inside a function body.
(ns g20c (:export [probe]))
(defn specs [] [:list [:map :keyword :string]]
  [(typed-map-new [:map :keyword :string] :entity "ReserveData" :plural "reservedatas")
   (typed-map-new [:map :keyword :string] :entity "EModeCategory" :plural "emodecategories")])
(defn probe [] :i64 (count (specs)))
