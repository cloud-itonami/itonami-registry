;; Row 13. guest-grammar.edn's :some-> note says "compiler steps consume and
;; return explicit Options", so the step is Option -> Option, not i64 -> i64.
(ns g13d (:export [probe]))
(defn twice [a :i64] [:option :i64] (option-some-of [:option :i64] (* a 2)))
(defn probe [] :i64
  (option-value-of [:option :i64] (some-> (option-some-of [:option :i64] 21) twice) 0))
