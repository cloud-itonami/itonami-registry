;; Row 22 with :string values, correct arity.
(ns g22d (:export [probe]))
(defn m [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string] :entity "ReserveData" :plural "reservedatas"))
(defn probe [] :i64
  (string-byte-length
    (option-value-of [:option :string] (typed-map-get [:map :keyword :string] (m) :plural) "")))
