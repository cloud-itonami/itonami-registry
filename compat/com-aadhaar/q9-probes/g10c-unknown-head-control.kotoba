;; Control for g10a. g10a's refusal named `big?`, not `remove`, which would mean
;; arguments are typed BEFORE the head is resolved. This probe holds the head
;; definitely-unknown and the argument well-typed, to see which refusal wins.
(ns g10c (:export [probe]))
(def xs [1 2 3])
(defn probe [] :i64 (count (definitely-not-a-head xs)))
