;; Row 20 on the :document carrier. document-vector-count does not exist;
;; document-count is the arity-1 head in document-fixed-operations.
(ns g20f (:export [probe]))
(defn specs [] :document
  (document [{:entity "ReserveData" :plural "reservedatas"}
             {:entity "EModeCategory" :plural "emodecategories"}]))
(defn probe [] :i64 (document-count (specs)))
