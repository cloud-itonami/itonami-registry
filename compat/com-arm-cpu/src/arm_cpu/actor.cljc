  {:id id :deleted true})

;; ── PowerState ────────────────────────────────────────────────────────────────
(defn create-power-state
  "Create a PowerState."
  [port data]
  (require-fields data ["name" "voltageV"])
  (let [id (new-id "acpu_pow")
        e {:db/id id
           :arm_cpu.PowerState/id id
           :arm_cpu.PowerState/coreId (get data :coreId)
           :arm_cpu.PowerState/name (get data :name)
           :arm_cpu.PowerState/voltageV (as-double (get data :voltageV))
           :arm_cpu.PowerState/powerMw (as-double (get data :powerMw))
           :arm_cpu.PowerState/createdAt (now)
           :arm_cpu.PowerState/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-power-states
  "List PowerState with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-power-states port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :arm_cpu.PowerState/id))
         rows (apply-filters rows (:filter opts) [:arm_cpu.PowerState/coreId :arm_cpu.PowerState/name :arm_cpu.PowerState/voltageV :arm_cpu.PowerState/powerMw])]
     (paginate rows opts))))

(defn get-power-state
  "Retrieve a PowerState by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-power-state port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-power-state
  "Update a PowerState; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :coreId) (conj [:db/add id :arm_cpu.PowerState/coreId (get data :coreId)]))
                   (cond-> (contains? data :name) (conj [:db/add id :arm_cpu.PowerState/name (get data :name)]))
                   (cond-> (contains? data :voltageV) (conj [:db/add id :arm_cpu.PowerState/voltageV (as-double (get data :voltageV))]))
                   (cond-> (contains? data :powerMw) (conj [:db/add id :arm_cpu.PowerState/powerMw (as-double (get data :powerMw))]))
                   (conj [:db/add id :arm_cpu.PowerState/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-power-state
  "Delete a PowerState."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

