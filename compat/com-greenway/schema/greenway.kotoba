// Greenway clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace greenway {

    entity Patient {
        id: string @unique
        mrn: string
        givenName: string
        familyName: string
        birthDate: datetime
        sex: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Encounter {
        id: string @unique
        patientId: string
        type: string
        status: string
        startedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Observation {
        id: string @unique
        patientId: string
        code: string
        value: string
        unit: string
        takenAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Medication {
        id: string @unique
        patientId: string
        code: string
        dose: string
        route: string
        active: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Practitioner {
        id: string @unique
        npi: string
        givenName: string
        familyName: string
        specialty: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Appointment {
        id: string @unique
        patientId: string
        practitionerId: string
        start: datetime
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
