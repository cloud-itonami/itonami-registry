// Gitlab clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace gitlab {

    entity Project {
        id: string @unique
        name: string
        path: string
        description: string
        visibility: string
        defaultBranch: string
        archived: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Issue {
        id: string @unique
        projectId: integer
        iid: integer
        title: string
        description: string
        state: string
        issueType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity MergeRequest {
        id: string @unique
        projectId: integer
        iid: integer
        title: string
        state: string
        sourceBranch: string
        targetBranch: string
        sha: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Pipeline {
        id: string @unique
        projectId: integer
        status: string
        ref: string
        sha: string
        duration: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Job {
        id: string @unique
        name: string
        status: string
        stage: string
        ref: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Commit {
        id: string @unique
        shortId: string
        title: string
        message: string
        authorName: string
        authorEmail: string
        createdAt: datetime
        updatedAt: datetime
    }

}
