// Tcp_ip clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace tcp_ip {

    entity TcpSegment {
        id: string @unique
        sourcePort: integer
        destinationPort: integer
        sequenceNumber: integer
        acknowledgmentNumber: integer
        dataOffset: integer
        controlBits: string
        window: integer
        urgentPointer: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity TcpConnection {
        id: string @unique
        localPort: integer
        remotePort: integer
        state: string
        sequenceSendNext: integer
        sequenceReceiveNext: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity IpPacket {
        id: string @unique
        version: integer
        headerLength: integer
        totalLength: integer
        identification: integer
        flags: string
        fragmentOffset: integer
        timeToLive: integer
        protocol: integer
        sourceAddress: string
        destinationAddress: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity IcmpMessage {
        id: string @unique
        type: integer
        code: integer
        checksum: string
        restOfHeader: string
        createdAt: datetime
        updatedAt: datetime
    }

}
