// Comma_ai_openpilot clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace comma_ai_openpilot {

    entity Event {
        id: string @unique
        logMonoTime: integer
        valid: boolean
        logMessage: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity CarState {
        id: string @unique
        vEgo: float
        aEgo: float
        standstill: boolean
        gasPressed: boolean
        brakePressed: boolean
        steeringAngleDeg: float
        steeringTorque: float
        gearShifter: string
        leftBlinker: boolean
        rightBlinker: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity CarControl {
        id: string @unique
        enabled: boolean
        latActive: boolean
        longActive: boolean
        leftBlinker: boolean
        rightBlinker: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity CarParams {
        id: string @unique
        brand: string
        carFingerprint: string
        minEnableSpeed: float
        minSteerSpeed: float
        mass: float
        wheelbase: float
        createdAt: datetime
        updatedAt: datetime
    }

}
