{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "family", "observedOn", "method", "count", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "itonami.dataset-sources.v1"},
    "family": {"enum": ["lei", "assoc", "municipality"]},
    "observedOn": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "method": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repository", "commit", "visibility", "archived", "license", "keys", "payload", "digestStatus", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^(lei|assoc|municipality)/[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^cloud-itonami/cloud-itonami-[A-Za-z0-9_.-]+$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "visibility": {"const": "public"},
          "archived": {"type": "boolean"},
          "license": {"type": "string", "minLength": 1},
          "keys": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "payload": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./-]*$",
                  "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
                },
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "digestStatus": {"enum": ["verified", "unverified"]},
          "status": {"const": "repository-owned"}
        }
      }
    }
  }
}
