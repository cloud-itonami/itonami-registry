{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "itonami.targeted-public-sources.v1"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "commit", "visibility", "reviewedOn", "reviewBasis", "registrations"],
        "additionalProperties": false,
        "properties": {
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "visibility": {"const": "public"},
          "reviewedOn": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "reviewBasis": {"type": "string", "minLength": 1},
          "registrations": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["entry", "sourceCommit"], "additionalProperties": false,
              "properties": {
                "entry": {"type": "string", "pattern": "^(agent|skill|mcp|workflow|profile)/[a-z0-9-]+$"},
                "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            }
          }
        }
      }
    }
  }
}
