{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Itonami origin-domain extract",
  "description": "Public extract of the owner's origin-domain record: repository -> registrable domain, for api entries only (ADR 0005 §4). Provenance pins the private source commit and file digests.",
  "type": "object",
  "required": ["schemaVersion", "note", "source", "count", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "itonami.origin-domains.v1"},
    "note": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["repository", "visibility", "commit", "files", "schema", "authorityBindingEvidence", "extracted"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "visibility": {"enum": ["public", "private"]},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["path", "sha256", "role"], "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./-]*$", "not": {"pattern": "(^|/)\\.\\.?(/|$)"}},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "role": {"enum": ["view", "authority"]}
            }
          }
        },
        "schema": {"const": "kotoba.origin-domains.v1"},
        "recordDnsCheckedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "authorityBindingEvidence": {"type": "string", "minLength": 1},
        "extracted": {"type": "string", "minLength": 1}
      }
    },
    "count": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["api", "repository", "domain", "reverseDomain", "nameMatchesDomain"],
        "additionalProperties": false,
        "properties": {
          "api": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,99}$"},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "domain": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"},
          "reverseDomain": {"type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"},
          "nameMatchesDomain": {"type": "boolean"}
        }
      }
    }
  }
}
