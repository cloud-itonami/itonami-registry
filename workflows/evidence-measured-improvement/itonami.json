{
  "schemaVersion": "itonami.entry.v1",
  "sourceRefs": [
    "isic"
  ],
  "useWhen": "Owner-scoped evidence review and improvement",
  "avoidWhen": "Unattended mutation without bound policy",
  "inputs": {
    "parameters": [
      "targetRepo",
      "taxonomy",
      "premise",
      "specPath",
      "testArgv",
      "evidenceArgv"
    ]
  },
  "outputs": {
    "result": "evidenced report or scoped proposal"
  },
  "effects": [
    "process",
    "filesystem-read",
    "optional-owner-authorized-write"
  ],
  "authority": {
    "grants": false,
    "default": "blocked",
    "binding": "owner-reviewed target repository policy"
  },
  "validation": {
    "catalog": "schema-checked",
    "runtime": "not-tested",
    "live": false
  },
  "compatibilityNote": "Hermes storage format only; client installation and execution are not qualified. Wildcard versions do not establish runtime compatibility.",
  "executionNote": "workflow.json is an Itonami declarative recipe; no Hermes workflow executor compatibility is claimed."
}
